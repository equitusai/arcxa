                ts: Utc::now(),
                run_id: "test_run".to_string(),
                tenant_id: "test_tenant".to_string(),
                correlation_id: None,
                metadata: HashMap::new(),
            };

            bridge.send_lineage_event(event);
        }

        // Wait for processing
        std::thread::sleep(Duration::from_millis(200));

        // Verify events were processed (triples inserted)
        let triple_count = governance_brain.triple_count().unwrap();
        assert!(triple_count > 0, "Should have inserted triples: got {}", triple_count);
    }

    // ============================================================================
    // CRITICAL FIX TESTS (Phase 1.5) - Lock Contention Fix
    // ============================================================================

    #[test]
    fn test_separate_channels_no_lock_contention() {
        // This test verifies that we have separate channels (no Arc<Mutex>)
        // We send events concurrently from multiple threads and verify
        // that they all complete quickly (proving no lock contention)

        let temp_dir = TempDir::new().unwrap();
        let store_path = temp_dir.path().join("rdf");
        std::fs::create_dir_all(&store_path).unwrap();

        let brain = crate::governance::GovernanceBrain::new(store_path.to_str().unwrap()).unwrap();
        let governance_brain = Arc::new(SharedGovernanceBrain::new(brain));

        // Create bridge with 4 processors
        let config = AsyncGovernanceConfig {
            batch_size: 100,
            batch_timeout: Duration::from_millis(50),
            num_processors: 4,
            channel_capacity: 1000,
            max_retries: 1,
            enable_metrics: false,
        };

        let bridge = GovernanceBridge::new(governance_brain.clone(), config).unwrap();

        // Send events from 4 concurrent threads
        // If there's lock contention, this will be very slow
        let start = std::time::Instant::now();
        let handles: Vec<_> = (0..4).map(|thread_id| {
            let bridge_clone = bridge.clone();
            std::thread::spawn(move || {
                for i in 0..100 {
                    let event = LineageEvent {
                        id: uuid::Uuid::new_v4(),
                        dataset: format!("dataset_{}_{}", thread_id, i),
                        record_id: format!("rec_{}_{}", thread_id, i),
                        source_refs: vec![],
                        transforms: vec![],
                        model_refs: vec![],
                        output_ref: DataRef {
                            system: "test".to_string(),
                            path: "test/path".to_string(),
                            version: None,
                            extracted_at: Utc::now(),
                            cdc_position: None,
                        },
                        ts: Utc::now(),
                        run_id: "test_run".to_string(),
                        tenant_id: "test_tenant".to_string(),
                        correlation_id: None,
                        metadata: HashMap::new(),
                    };
                    bridge_clone.send_lineage_event(event);
                }
            })
        }).collect();

        // Wait for all threads
        for handle in handles {
            handle.join().unwrap();
        }

        let duration = start.elapsed();

        // With proper separate channels, sending 400 events from 4 threads
        // should complete in well under 1 second
        // With lock contention (Arc<Mutex>), it would take much longer
        println!("Sent 400 events from 4 threads in {:?}", duration);
        assert!(duration.as_millis() < 500, "Took too long - possible lock contention: {:?}", duration);

        // Wait for processing
        std::thread::sleep(Duration::from_millis(300));

        bridge.shutdown();
    }

    #[test]
    fn test_round_robin_distribution() {
        // This test verifies that events are distributed evenly across processors
        // using round-robin

        let temp_dir = TempDir::new().unwrap();
        let store_path = temp_dir.path().join("rdf");
        std::fs::create_dir_all(&store_path).unwrap();

        let brain = crate::governance::GovernanceBrain::new(store_path.to_str().unwrap()).unwrap();
        let governance_brain = Arc::new(SharedGovernanceBrain::new(brain));

        let config = AsyncGovernanceConfig {
            batch_size: 1000,
            batch_timeout: Duration::from_millis(100),
            num_processors: 4,
            channel_capacity: 1000,
            max_retries: 1,
            enable_metrics: false,
        };

        let bridge = GovernanceBridge::new(governance_brain.clone(), config).unwrap();

        // Verify we have 4 senders
        assert_eq!(bridge.senders.len(), 4, "Should have 4 separate senders");

        // Send 12 events - should distribute 3 to each processor
        for i in 0..12 {
            let event = LineageEvent {
                id: uuid::Uuid::new_v4(),
                dataset: format!("dataset_{}", i),
                record_id: format!("rec_{}", i),
                source_refs: vec![],
                transforms: vec![],
                model_refs: vec![],
                output_ref: DataRef {
                    system: "test".to_string(),
                    path: "test/path".to_string(),
                    version: None,
                    extracted_at: Utc::now(),
                    cdc_position: None,
                },
                ts: Utc::now(),
                run_id: "test_run".to_string(),
                tenant_id: "test_tenant".to_string(),
                correlation_id: None,
                metadata: HashMap::new(),
            };
            bridge.send_lineage_event(event);
        }

        // Verify round-robin counter wrapped correctly
        // After 12 events, next_sender_index should be 12 % 4 = 0 (wrapped around 3 times)
        let final_index = bridge.next_sender_index.load(Ordering::Relaxed);
        assert_eq!(final_index, 12, "Round-robin counter should be at 12");

        // Wait for processing
        std::thread::sleep(Duration::from_millis(200));

        bridge.shutdown();
    }


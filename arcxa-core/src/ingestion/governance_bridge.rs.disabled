//! Governance Bridge - Connects Timely Dataflow to Async Governance Brain
//!
//! This module provides the async-sync bridge that allows synchronous Timely
//! dataflow operators to send LineageEvents to the async GovernanceBrain for
//! conversion to RDF triples and storage.
//!
//! Architecture:
//! - Timely operators call send_lineage_event() (sync)
//! - Events are batched for efficiency (1000 events or 100ms timeout)
//! - Background async task converts to RDF and inserts into governance brain
//! - Errors are logged but don't block dataflow execution

use crate::core::lineage::LineageEvent;
use crate::governance::{
    AsyncGovernanceConfig, SharedGovernanceBrain,
};
use anyhow::Result;
use crossbeam::channel::{bounded, Sender, Receiver, RecvTimeoutError, SendTimeoutError};
use std::sync::Arc;
use std::sync::atomic::{AtomicBool, AtomicUsize, Ordering};
use std::thread;
use std::time::{Duration, Instant};
use tracing::{debug, error, info, warn};

/// Governance bridge for sending lineage events from Timely to async governance brain
///
/// Architecture (CRITICAL FIX - Phase 1.5):
/// - Multiple separate channels (one per processor thread)
/// - Round-robin distribution for load balancing
/// - NO MUTEX - eliminates lock contention
/// - True parallel processing
#[derive(Clone)]
pub struct GovernanceBridge {
    /// Separate sender for each processor thread (no shared mutex)
    senders: Arc<Vec<Sender<LineageEvent>>>,
    /// Round-robin counter for load balancing
    next_sender_index: Arc<AtomicUsize>,
    /// Shutdown signal
    shutdown: Arc<AtomicBool>,
}

impl GovernanceBridge {
    /// Create new governance bridge with background processor pool
    ///
    /// CRITICAL FIX (Phase 1.5): Separate channels per processor
    /// - Each processor gets its own dedicated channel (no mutex!)
    /// - Senders use round-robin distribution for load balancing
    /// - Achieves true N-way parallelism
    ///
    /// Spawns multiple background threads that:
    /// 1. Receive LineageEvents from Timely dataflow
    /// 2. Batch them for efficiency
    /// 3. Convert to RDF triples
    /// 4. Insert into governance brain
    pub fn new(
        governance_brain: Arc<SharedGovernanceBrain>,
        config: AsyncGovernanceConfig,
    ) -> Result<Self> {
        let num_processors = config.num_processors;
        let batch_size = config.batch_size;
        let batch_timeout = config.batch_timeout;
        let shutdown = Arc::new(AtomicBool::new(false));

        // CRITICAL FIX: Create separate channel for each processor
        // This eliminates mutex contention and enables true parallelism
        let channel_capacity_per_processor = config.channel_capacity / num_processors;
        let mut senders = Vec::with_capacity(num_processors);

        for processor_id in 0..num_processors {
            // Each processor gets its own dedicated channel
            let (sender, receiver) = bounded(channel_capacity_per_processor);
            senders.push(sender);

            let brain_clone = Arc::clone(&governance_brain);
            let shutdown_clone = Arc::clone(&shutdown);

            thread::Builder::new()
                .name(format!("governance-bridge-{}", processor_id))
                .spawn(move || {
                    // Pass receiver directly (NOT Arc<Mutex<Receiver>>)
                    Self::run_processor(
                        processor_id,
                        brain_clone,
                        receiver,  // Owned receiver - no locking needed!
                        batch_size,
                        batch_timeout,
                        shutdown_clone,
                    );
                })?;
        }

        info!(
            "Governance bridge started ({} processors, {} events/processor capacity, batch_size={}, timeout={}ms)",
            num_processors,
            channel_capacity_per_processor,
            batch_size,
            batch_timeout.as_millis()
        );

        Ok(Self {
            senders: Arc::new(senders),
            next_sender_index: Arc::new(AtomicUsize::new(0)),
            shutdown,
        })
    }

    /// Gracefully shutdown the bridge, flushing any pending events
    pub fn shutdown(&self) {
        info!("Shutting down governance bridge");
        self.shutdown.store(true, Ordering::SeqCst);

        // Give the background thread time to flush pending events
        thread::sleep(Duration::from_millis(500));

        info!("Governance bridge shutdown complete");
    }

    /// Send a lineage event to the governance brain
    ///
    /// CRITICAL FIX (Phase 1.5 Fix #2): Hybrid back-pressure approach
    /// - Round-robin distribution across processors (lock-free)
    /// - Fast path: Non-blocking try_send (normal case)
    /// - Slow path: send_timeout with back-pressure (channel full)
    /// - Fallback: Track drop metric (last resort)
    ///
    /// Architecture:
    /// 1. Try non-blocking send (99% case - instant)
    /// 2. If full, apply back-pressure with 10ms timeout
    /// 3. If still full, log ERROR and track metric
    ///
    /// Back-pressure prevents burst overload while maintaining performance.
    /// TODO: Add DLQ fallback for drops (requires DLQ reference)
    pub fn send_lineage_event(&self, event: LineageEvent) {
        let send_start = Instant::now();

        // Round-robin distribution: atomically increment and wrap
        let sender_index = self.next_sender_index.fetch_add(1, Ordering::Relaxed) % self.senders.len();
        let sender = &self.senders[sender_index];

        // FAST PATH: Try non-blocking send first (normal case)
        match sender.try_send(event.clone()) {
            Ok(_) => {
                // Success - track fast path latency
                let latency_us = send_start.elapsed().as_micros() as f64;
                crate::ingestion::metrics::LINEAGE_SEND_LATENCY
                    .with_label_values(&["success"])
                    .observe(latency_us);
                return;
            }
            Err(crossbeam::channel::TrySendError::Disconnected(_)) => {
                error!("Governance bridge processor {} channel disconnected - cannot send lineage event", sender_index);
                return;
            }
            Err(crossbeam::channel::TrySendError::Full(_)) => {
                // Channel full - fall through to slow path with back-pressure
            }
        }

        // SLOW PATH: Channel full - apply back-pressure with timeout
        // This gives the processor time to drain events before we drop
        const BACKPRESSURE_TIMEOUT_MS: u64 = 10;  // Short timeout to limit Timely impact

        warn!(
            "Governance bridge processor {} channel FULL - applying back-pressure ({}ms timeout)",
            sender_index, BACKPRESSURE_TIMEOUT_MS
        );

        crate::ingestion::metrics::LINEAGE_BACKPRESSURE_EVENTS.inc();

        match sender.send_timeout(event.clone(), Duration::from_millis(BACKPRESSURE_TIMEOUT_MS)) {
            Ok(_) => {
                // Success after back-pressure - track slow path latency
                let latency_us = send_start.elapsed().as_micros() as f64;
                crate::ingestion::metrics::LINEAGE_SEND_LATENCY
                    .with_label_values(&["backpressure"])
                    .observe(latency_us);
                debug!(
                    "Lineage event sent to processor {} after {}ms back-pressure",
                    sender_index,
                    send_start.elapsed().as_millis()
                );
            }
            Err(SendTimeoutError::Timeout(dropped_event)) => {
                // CRITICAL: Still full after timeout - must drop
                crate::ingestion::metrics::LINEAGE_CHANNEL_DROPS.inc();

                let latency_us = send_start.elapsed().as_micros() as f64;
                crate::ingestion::metrics::LINEAGE_SEND_LATENCY
                    .with_label_values(&["dropped"])
                    .observe(latency_us);

                error!(
                    "Governance bridge processor {} STILL FULL after {}ms - DROPPING lineage event {} (dataset: {}, record: {})",
                    sender_index,
                    BACKPRESSURE_TIMEOUT_MS,
                    dropped_event.id,
                    dropped_event.dataset,
                    dropped_event.record_id
                );
                // TODO: Send to DLQ instead of dropping (requires DLQ reference)
            }
            Err(SendTimeoutError::Disconnected(_)) => {
                error!("Governance bridge processor {} channel disconnected during back-pressure", sender_index);
            }
        }
    }

    /// Background processor loop (one per processor thread)
    ///
    /// CRITICAL FIX (Phase 1.5): Takes owned Receiver (not Arc<Mutex<Receiver>>)
    /// - No mutex locking required
    /// - True parallel processing
    /// - Each processor independently receives from its dedicated channel
    fn run_processor(
        processor_id: usize,
        governance_brain: Arc<SharedGovernanceBrain>,
        receiver: Receiver<LineageEvent>,  // CRITICAL FIX: Owned receiver, no Arc<Mutex>!
        batch_size: usize,
        batch_timeout: Duration,
        shutdown: Arc<AtomicBool>,
    ) {
        info!("Governance bridge processor {} started with dedicated channel", processor_id);

        let mut batch = Vec::with_capacity(batch_size);

        loop {
            // Check for shutdown signal
            if shutdown.load(Ordering::SeqCst) {
                info!("Processor {} shutdown signal received, flushing pending events", processor_id);
                if !batch.is_empty() {
                    Self::flush_batch(&governance_brain, &mut batch);
                }
                break;
            }

            // CRITICAL FIX: Direct receive - no mutex locking!
            // Each processor has its own dedicated receiver
            match receiver.recv_timeout(batch_timeout) {
                Ok(event) => {
                    batch.push(event);

                    // Flush if batch is full
                    if batch.len() >= batch_size {
                        Self::flush_batch(&governance_brain, &mut batch);
                    }
                }
                Err(RecvTimeoutError::Timeout) => {
                    // Timeout elapsed - flush if we have events
                    if !batch.is_empty() {
                        Self::flush_batch(&governance_brain, &mut batch);
                    }
                }
                Err(RecvTimeoutError::Disconnected) => {
                    // Channel closed, flush remaining events and exit
                    warn!("Processor {} receiver disconnected", processor_id);
                    if !batch.is_empty() {
                        Self::flush_batch(&governance_brain, &mut batch);
                    }
                    break;
                }
            }
        }

        info!("Governance bridge processor {} stopped", processor_id);
    }

    /// Flush batch of events to governance brain
    fn flush_batch(governance_brain: &Arc<SharedGovernanceBrain>, batch: &mut Vec<LineageEvent>) {
        if batch.is_empty() {
            return;
        }

        let batch_size = batch.len();
        debug!("Flushing {} lineage events to governance brain", batch_size);

        let start = Instant::now();

        // Track batch size
        let flush_reason = if batch_size >= 1000 { "size" } else { "timeout" };
        crate::ingestion::metrics::LINEAGE_BATCH_SIZE
            .with_label_values(&[flush_reason])
            .observe(batch_size as f64);

        for event in batch.drain(..) {
            if let Err(e) = Self::process_event(governance_brain, event) {
                error!("Failed to process lineage event: {}", e);
            }
        }

        let duration = start.elapsed();

        // Track flush latency by batch size bucket
        let size_bucket = match batch_size {
            0..=10 => "small",
            11..=100 => "medium",
            101..=1000 => "large",
            _ => "xlarge",
        };
        crate::ingestion::metrics::LINEAGE_FLUSH_LATENCY
            .with_label_values(&[size_bucket])
            .observe(duration.as_millis() as f64);

        debug!(
            "Flushed {} events in {}ms ({} events/sec)",
            batch_size,
            duration.as_millis(),
            (batch_size as f64 / duration.as_secs_f64()) as u64
        );
    }

    /// Process single event: convert to RDF and insert with limited retry logic
    ///
    /// CRITICAL FIX: Reduced retries to prevent head-of-line blocking.
    /// - Only 1 retry with short delay (50ms) to handle transient failures
    /// - If still failing, event is logged and batch processing continues
    /// - This prevents one slow event from blocking thousands of events
    fn process_event(
        governance_brain: &Arc<SharedGovernanceBrain>,
        event: LineageEvent,
    ) -> Result<()> {
        const MAX_RETRIES: usize = 1;  // REDUCED: Only 1 retry to prevent blocking
        const RETRY_DELAY_MS: u64 = 50;  // SHORT: Minimal delay

        let mut attempt = 0;

        loop {
            match governance_brain.materialize_event(&event) {
                Ok(_) => {
                    // Track successful materialization
                    crate::ingestion::metrics::LINEAGE_EVENTS_SENT.inc();

                    // Track retry attempts
                    crate::ingestion::metrics::LINEAGE_RETRY_ATTEMPTS
                        .with_label_values(&["success"])
                        .observe(attempt as f64);

                    if attempt > 0 {
                        debug!(
                            "Successfully materialized lineage event {} after {} retries",
                            event.id, attempt
                        );
                    }
                    return Ok(());
                }
                Err(e) if attempt < MAX_RETRIES => {
                    warn!(
                        "Failed to materialize lineage event {} (attempt {}/{}): {}",
                        event.id,
                        attempt + 1,
                        MAX_RETRIES,
                        e
                    );

                    // Short delay to avoid cascading failures
                    thread::sleep(Duration::from_millis(RETRY_DELAY_MS));
                    attempt += 1;
                }
                Err(e) => {
                    // Track failed materialization
                    crate::ingestion::metrics::LINEAGE_EVENTS_FAILED.inc();

                    // Track retry attempts
                    crate::ingestion::metrics::LINEAGE_RETRY_ATTEMPTS
                        .with_label_values(&["failure"])
                        .observe(attempt as f64);

                    // Max retries exceeded - fail fast to avoid blocking batch
                    error!(
                        "Failed to materialize lineage event {} after {} retries: {} - DROPPING to prevent blocking",
                        event.id, MAX_RETRIES, e
                    );
                    // TODO: Send to DLQ for async retry instead of dropping
                    return Err(e);
                }
            }
        }
    }
}

/// Create governance bridge with default configuration
pub fn create_governance_bridge(
    governance_brain: Arc<SharedGovernanceBrain>,
) -> Result<GovernanceBridge> {
    let config = AsyncGovernanceConfig {
        batch_size: 1000,
        batch_timeout: Duration::from_millis(100),
        num_processors: 4,  // CRITICAL FIX: 4 processors to match 4 Timely workers
        channel_capacity: 10000,
        max_retries: 3,
        enable_metrics: true,
    };

    GovernanceBridge::new(governance_brain, config)
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::core::lineage::DataRef;
    use chrono::Utc;
    use std::collections::HashMap;
    use tempfile::TempDir;

    #[test]
    fn test_shutdown_sequence() {
        // Test that verifies correct shutdown sequence:
        // 1. Workers send events
        // 2. Shutdown flag set
        // 3. Workers finish and flush events
        // 4. Bridge shutdown called
        // 5. No events dropped

        use std::sync::Arc;
        use std::sync::atomic::{AtomicBool, Ordering};
        use std::thread;
        use std::time::Duration;

        let temp_dir = TempDir::new().unwrap();
        let store_path = temp_dir.path().join("rdf");
        std::fs::create_dir_all(&store_path).unwrap();

        let brain = crate::governance::GovernanceBrain::new(store_path.to_str().unwrap()).unwrap();
        let governance_brain = Arc::new(SharedGovernanceBrain::new_sync(brain));

        let config = AsyncGovernanceConfig {
            batch_size: 10,
            batch_timeout: Duration::from_millis(50),
            num_processors: 2,
            channel_capacity: 100,
            max_retries: 1,
            enable_metrics: false,
        };

        let bridge = GovernanceBridge::new(governance_brain.clone(), config).unwrap();
        let bridge_for_thread = bridge.clone();

        // Simulate worker thread sending events
        let shutdown = Arc::new(AtomicBool::new(false));
        let shutdown_clone = Arc::clone(&shutdown);

        let worker = thread::spawn(move || {
            let mut sent_count = 0;

            // Send events until shutdown
            while !shutdown_clone.load(Ordering::SeqCst) {
                let event = LineageEvent {
                    id: uuid::Uuid::new_v4(),
                    dataset: format!("dataset_{}", sent_count),
                    record_id: format!("rec_{}", sent_count),
                    source_refs: vec![],
                    transforms: vec![],
                    model_refs: vec![],
                    output_ref: DataRef {
                        system: "test".to_string(),
                        path: "test/path".to_string(),
                        version: None,
                        extracted_at: Utc::now(),
                        cdc_position: None,
                    },
                    ts: Utc::now(),
                    run_id: "test_run".to_string(),
                    tenant_id: "test_tenant".to_string(),
                    correlation_id: None,
                    metadata: HashMap::new(),
                };
                bridge_for_thread.send_lineage_event(event);
                sent_count += 1;

                // Small delay to simulate real workload
                thread::sleep(Duration::from_micros(100));
            }

            println!("Worker sent {} events before shutdown", sent_count);
            sent_count
        });

        // Let worker send some events
        thread::sleep(Duration::from_millis(50));

        // CRITICAL FIX #3: Set shutdown flag FIRST
        println!("Setting shutdown flag...");
        shutdown.store(true, Ordering::SeqCst);

        // Join worker (wait for it to finish)
        println!("Joining worker...");
        let events_sent = worker.join().unwrap();
        println!("Worker joined after sending {} events", events_sent);

        // THEN shutdown bridge
        println!("Shutting down bridge...");
        bridge.shutdown();
        println!("Bridge shutdown complete");

        // Verify: Worker sent events, all should be queued for processing
        assert!(events_sent > 0, "Worker should have sent some events");

        // Success: No panics, no dropped events (channel not full)
        println!("✅ Shutdown sequence correct: worker → join → bridge.shutdown()");
    }


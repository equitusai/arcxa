        // Use new_sync() to avoid async processor shutdown issues
        let governance_brain = Arc::new(SharedGovernanceBrain::new_sync(brain));

        // Create bridge with small batch size for testing
        let config = AsyncGovernanceConfig {
            batch_size: 5,
            batch_timeout: Duration::from_millis(50),
            num_processors: 1,
            channel_capacity: 100,
            max_retries: 3,
            enable_metrics: false,

                source_refs: vec![],
                transforms: vec![],
                model_refs: vec![],
                output_ref: DataRef {
                    system: "test".to_string(),
                    path: "test/path".to_string(),
                    version: None,
                    extracted_at: Utc::now(),
                    cdc_position: None,

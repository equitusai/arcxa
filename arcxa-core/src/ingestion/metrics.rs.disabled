/// Governance bridge channel utilization (0.0-1.0)
pub static LINEAGE_CHANNEL_UTILIZATION: Lazy<Gauge> = Lazy::new(|| {
    register_gauge!(
        "graphica_lineage_channel_utilization",
        "Governance bridge channel utilization (0.0-1.0)"
    )
    .expect("Failed to create LINEAGE_CHANNEL_UTILIZATION metric")
});

/// Governance bridge channel drops (events lost due to full channel)
pub static LINEAGE_CHANNEL_DROPS: Lazy<Counter> = Lazy::new(|| {
    register_counter!(
        "graphica_lineage_channel_drops_total",
        "Total lineage events dropped due to full channel"
    )
    .expect("Failed to create LINEAGE_CHANNEL_DROPS metric")
});

/// Governance bridge back-pressure events (send blocked due to full channel)
pub static LINEAGE_BACKPRESSURE_EVENTS: Lazy<Counter> = Lazy::new(|| {
    register_counter!(
        "graphica_lineage_backpressure_total",
        "Total back-pressure events (send blocked waiting for channel space)"
    )
    .expect("Failed to create LINEAGE_BACKPRESSURE_EVENTS metric")
});

/// Governance bridge send latency (including back-pressure waits)
pub static LINEAGE_SEND_LATENCY: Lazy<HistogramVec> = Lazy::new(|| {
    register_histogram_vec!(
        "graphica_lineage_send_latency_us",
        "Lineage event send latency in microseconds (including back-pressure)",
        &["outcome"],  // "success", "backpressure", "dropped"
        vec![10.0, 50.0, 100.0, 500.0, 1000.0, 5000.0, 10000.0, 50000.0, 100000.0]
    )
    .expect("Failed to create LINEAGE_SEND_LATENCY metric")
});


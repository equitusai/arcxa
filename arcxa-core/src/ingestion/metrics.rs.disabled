#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_metrics_registration() {
        // Just verify metrics can be accessed
        RECORDS_PROCESSED.with_label_values(&["0", "dedup"]).inc();
        DEDUP_HITS.with_label_values(&["0"]).inc();
        assert!(true);
    }
}

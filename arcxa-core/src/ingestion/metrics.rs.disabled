//! # Streaming Pipeline Metrics
//!
//! Comprehensive Prometheus metrics for production observability

use once_cell::sync::Lazy;
use prometheus::{
    register_counter, register_counter_vec, register_gauge, register_gauge_vec, register_histogram_vec,
    Counter, CounterVec, Gauge, GaugeVec, HistogramVec,
};

/// Records processed by the streaming pipeline
pub static RECORDS_PROCESSED: Lazy<CounterVec> = Lazy::new(|| {
    register_counter_vec!(
        "graphica_records_processed_total",
        "Total number of records processed by the pipeline",
        &["worker_id", "stage"]
    )
    .expect("Failed to create RECORDS_PROCESSED metric")
});

/// Records dropped due to errors or quality issues
pub static RECORDS_DROPPED: Lazy<CounterVec> = Lazy::new(|| {
    register_counter_vec!(
        "graphica_records_dropped_total",
        "Total number of records dropped",
        &["worker_id", "reason"]
    )
    .expect("Failed to create RECORDS_DROPPED metric")
});

/// Processing latency histogram (in milliseconds)
pub static PROCESSING_LATENCY: Lazy<HistogramVec> = Lazy::new(|| {
    register_histogram_vec!(
        "graphica_processing_latency_ms",
        "Processing latency in milliseconds",
        &["worker_id", "stage"],
        vec![1.0, 5.0, 10.0, 25.0, 50.0, 100.0, 250.0, 500.0, 1000.0]
    )
    .expect("Failed to create PROCESSING_LATENCY metric")
});

/// Deduplication state size
pub static DEDUP_MAP_SIZE: Lazy<GaugeVec> = Lazy::new(|| {
    register_gauge_vec!(
        "graphica_dedup_map_size",
        "Number of entries in deduplication map",
        &["worker_id"]
    )
    .expect("Failed to create DEDUP_MAP_SIZE metric")
});


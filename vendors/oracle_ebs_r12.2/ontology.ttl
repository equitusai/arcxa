# ============================================================================
# OBJECT PROPERTIES (Relationships)
# ============================================================================

oracle:belongsToLedger a owl:ObjectProperty ;
    rdfs:label "belongs to ledger" ;
    rdfs:comment "Links entities to their parent ledger" .

oracle:belongsToBatch a owl:ObjectProperty ;
    rdfs:label "belongs to batch" ;
    rdfs:comment "Links journals to their batch" .

oracle:hasAccountCombination a owl:ObjectProperty ;
    rdfs:label "has account combination" ;
    rdfs:comment "Links to chart of accounts combination" .

oracle:hasEvent a owl:ObjectProperty ;
    rdfs:label "has event" ;
    rdfs:comment "Links subledger accounting to business event" .

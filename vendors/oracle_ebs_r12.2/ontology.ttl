    rdfs:range xsd:string ;
    rdfs:label "Budget Version Name" .

oracle:BUDGET_VERSION_STATUS a owl:DatatypeProperty ;
    rdfs:domain oracle:GL_BUDGET_VERSIONS ;
    rdfs:range xsd:string ;
    rdfs:label "Budget Version Status" ;
    rdfs:comment "O=Open, F=Frozen, C=Current" .

oracle:BUDGET_VERSION_DATE_CREATED a owl:DatatypeProperty ;
    rdfs:domain oracle:GL_BUDGET_VERSIONS ;
    rdfs:range xsd:date ;
    rdfs:label "Date Created" .


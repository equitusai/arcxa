oracle:AE_BALANCE_TYPE_CODE a owl:DatatypeProperty ;
    rdfs:domain oracle:XLA_AE_HEADERS ;
    rdfs:range xsd:string ;
    rdfs:label "Balance Type Code" ;
    rdfs:comment "A=Actual, B=Budget, E=Encumbrance" .

oracle:AE_TRANSFER_TO_GL_FLAG a owl:DatatypeProperty ;
    rdfs:domain oracle:XLA_AE_HEADERS ;
    rdfs:range xsd:string ;
    rdfs:label "Transfer to GL Flag" ;
    rdfs:comment "Y=Transferred to GL, N=Not transferred" .

oracle:AE_GL_TRANSFER_DATE a owl:DatatypeProperty ;
    rdfs:domain oracle:XLA_AE_HEADERS ;
    rdfs:range xsd:date ;
    rdfs:label "GL Transfer Date" .


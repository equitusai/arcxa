    rdfs:comment "C=Customer, S=Supplier" .

# ---------- XLA_EVENTS ----------
oracle:XLA_EVENTS a owl:Class ;
    rdfs:label "Subledger Event" ;
    rdfs:comment "Business events triggering accounting (e.g., invoice, payment)" .

oracle:EVENT_ID_PK a owl:DatatypeProperty ;
    rdfs:domain oracle:XLA_EVENTS ;
    rdfs:range xsd:integer ;
    rdfs:label "Event ID" .

oracle:EVENT_TYPE_CODE a owl:DatatypeProperty ;
    rdfs:domain oracle:XLA_EVENTS ;
    rdfs:range xsd:string ;
    rdfs:label "Event Type Code" ;
    rdfs:comment "INVOICE_VALIDATED, PAYMENT_CLEARED, etc." .

oracle:EVENT_DATE a owl:DatatypeProperty ;
    rdfs:domain oracle:XLA_EVENTS ;
    rdfs:range xsd:date ;
    rdfs:label "Event Date" .

oracle:EVENT_STATUS_CODE a owl:DatatypeProperty ;
    rdfs:domain oracle:XLA_EVENTS ;
    rdfs:range xsd:string ;
    rdfs:label "Event Status Code" ;
    rdfs:comment "U=Unprocessed, P=Processed" .

oracle:EVENT_NUMBER a owl:DatatypeProperty ;
    rdfs:domain oracle:XLA_EVENTS ;
    rdfs:range xsd:integer ;
    rdfs:label "Event Number" ;
    rdfs:comment "Sequential event number" .

# ============================================================================
# CURRENCIES AND EXCHANGE RATES
# ============================================================================

# ---------- GL_DAILY_RATES ----------
oracle:GL_DAILY_RATES a owl:Class ;
    rdfs:label "Daily Exchange Rate" ;
    rdfs:comment "Currency conversion rates by date" .

oracle:RATE_FROM_CURRENCY a owl:DatatypeProperty ;
    rdfs:domain oracle:GL_DAILY_RATES ;
    rdfs:range xsd:string ;
    rdfs:label "From Currency" ;
    rdfs:comment "Source currency code (ISO 4217)" .

oracle:RATE_TO_CURRENCY a owl:DatatypeProperty ;
    rdfs:domain oracle:GL_DAILY_RATES ;
    rdfs:range xsd:string ;
    rdfs:label "To Currency" ;
    rdfs:comment "Target currency code (ISO 4217)" .

oracle:RATE_CONVERSION_DATE a owl:DatatypeProperty ;
    rdfs:domain oracle:GL_DAILY_RATES ;
    rdfs:range xsd:date ;
    rdfs:label "Conversion Date" .

oracle:RATE_CONVERSION_TYPE a owl:DatatypeProperty ;
    rdfs:domain oracle:GL_DAILY_RATES ;
    rdfs:range xsd:string ;
    rdfs:label "Conversion Type" ;
    rdfs:comment "Corporate, Spot, User, etc." .

oracle:RATE_CONVERSION_RATE a owl:DatatypeProperty ;
    rdfs:domain oracle:GL_DAILY_RATES ;
    rdfs:range xsd:decimal ;
    rdfs:label "Conversion Rate" ;
    rdfs:comment "Exchange rate (1 FROM_CURRENCY = X TO_CURRENCY)" .

oracle:RATE_INVERSE_CONVERSION_RATE a owl:DatatypeProperty ;
    rdfs:domain oracle:GL_DAILY_RATES ;
    rdfs:range xsd:decimal ;
    rdfs:label "Inverse Conversion Rate" .


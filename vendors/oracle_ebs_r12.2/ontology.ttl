    rdfs:domain oracle:GL_PERIODS ;
    rdfs:range xsd:string ;
    rdfs:label "Period Set Name" ;
    rdfs:comment "Calendar name (e.g., Month, 4-4-5)" .

oracle:PERIOD_TYPE a owl:DatatypeProperty ;
    rdfs:domain oracle:GL_PERIODS ;
    rdfs:range xsd:string ;
    rdfs:label "Period Type" ;
    rdfs:comment "Month, Quarter, Year" .

oracle:PERIOD_YEAR a owl:DatatypeProperty ;
    rdfs:domain oracle:GL_PERIODS ;
    rdfs:range xsd:integer ;
    rdfs:label "Period Year" .

oracle:PERIOD_NUM a owl:DatatypeProperty ;
    rdfs:domain oracle:GL_PERIODS ;
    rdfs:range xsd:integer ;
    rdfs:label "Period Number" ;
    rdfs:comment "Sequence number within year" .

oracle:PERIOD_START_DATE a owl:DatatypeProperty ;
    rdfs:domain oracle:GL_PERIODS ;
    rdfs:range xsd:date ;
    rdfs:label "Period Start Date" .

oracle:PERIOD_END_DATE a owl:DatatypeProperty ;
    rdfs:domain oracle:GL_PERIODS ;
    rdfs:range xsd:date ;
    rdfs:label "Period End Date" .

oracle:PERIOD_QUARTER_NUM a owl:DatatypeProperty ;
    rdfs:domain oracle:GL_PERIODS ;
    rdfs:range xsd:integer ;
    rdfs:label "Quarter Number" .

oracle:PERIOD_ADJUSTMENT_PERIOD_FLAG a owl:DatatypeProperty ;
    rdfs:domain oracle:GL_PERIODS ;
    rdfs:range xsd:string ;
    rdfs:label "Adjustment Period Flag" ;
    rdfs:comment "Y=Adjustment period (e.g., period 13), N=Regular period" .

# ---------- GL_PERIOD_STATUSES ----------
oracle:GL_PERIOD_STATUSES a owl:Class ;
    rdfs:label "Period Status" ;
    rdfs:comment "Period open/close status by ledger" .

oracle:PERIOD_STATUS_LEDGER_ID a owl:ObjectProperty ;

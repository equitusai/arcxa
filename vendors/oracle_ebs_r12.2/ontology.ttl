    rdfs:range oracle:GL_CODE_COMBINATIONS ;
    rdfs:label "Code Combination ID" .

oracle:AE_LINE_ENTERED_DR a owl:DatatypeProperty ;
    rdfs:domain oracle:XLA_AE_LINES ;
    rdfs:range xsd:decimal ;
    rdfs:label "Entered Debit" .

oracle:AE_LINE_ENTERED_CR a owl:DatatypeProperty ;
    rdfs:domain oracle:XLA_AE_LINES ;
    rdfs:range xsd:decimal ;
    rdfs:label "Entered Credit" .

oracle:AE_LINE_ACCOUNTED_DR a owl:DatatypeProperty ;
    rdfs:domain oracle:XLA_AE_LINES ;
    rdfs:range xsd:decimal ;
    rdfs:label "Accounted Debit" .

oracle:AE_LINE_ACCOUNTED_CR a owl:DatatypeProperty ;

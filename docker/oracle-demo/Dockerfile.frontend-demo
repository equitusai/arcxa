FROM node:20-bookworm AS build

ARG VITE_API_BASE_URL=http://localhost:18898/api/v1

WORKDIR /workspace

COPY graphica-frontend/package.json graphica-frontend/package-lock.json ./
RUN npm ci

COPY graphica-frontend/ ./
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
RUN npm run build

FROM nginx:1.27-alpine

COPY graphica/docker/oracle-demo/nginx.frontend.conf /etc/nginx/conf.d/default.conf
COPY --from=build /workspace/dist/ /usr/share/nginx/html/

EXPOSE 80

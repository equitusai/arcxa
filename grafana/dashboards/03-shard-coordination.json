{
  "dashboard": {
    "title": "Graphica - Shard Coordination",
    "tags": ["graphica", "sharding", "distributed"],
    "timezone": "browser",
    "schemaVersion": 36,
    "version": 1,
    "refresh": "5s",
    "time": {
      "from": "now-15m",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "title": "Shard Request Rate",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
        "targets": [{
          "expr": "rate(graphica_shard_requests_total[1m])",
          "legendFormat": "Shard {{shard_id}} - {{operation}}",
          "refId": "A"
        }],
        "yaxes": [
          {"format": "reqps", "label": "Requests/sec"},
          {"format": "short"}
        ]
      },
      {
        "id": 2,
        "title": "Shard Request Latency",
        "type": "graph",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(graphica_shard_request_duration_seconds_bucket[1m]))",
            "legendFormat": "P95 - Shard {{shard_id}}",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.99, rate(graphica_shard_request_duration_seconds_bucket[1m]))",
            "legendFormat": "P99 - Shard {{shard_id}}",
            "refId": "B"
          }
        ],
        "yaxes": [
          {"format": "s", "label": "Latency"},
          {"format": "short"}
        ]
      },
      {
        "id": 3,
        "title": "Load Distribution",
        "type": "bargauge",
        "gridPos": {"h": 8, "w": 6, "x": 0, "y": 8},
        "targets": [{
          "expr": "rate(graphica_shard_requests_total[5m])",
          "legendFormat": "Shard {{shard_id}}",
          "refId": "A"
        }],
        "options": {
          "orientation": "horizontal",
          "displayMode": "gradient"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "color": {"mode": "palette-classic"}
          }
        }
      },
      {
        "id": 4,
        "title": "Active Connections per Shard",
        "type": "graph",
        "gridPos": {"h": 8, "w": 6, "x": 6, "y": 8},
        "targets": [{
          "expr": "graphica_shard_connections_active",
          "legendFormat": "Shard {{shard_id}}",
          "refId": "A"
        }],
        "yaxes": [
          {"format": "short", "label": "Connections"},
          {"format": "short"}
        ]
      },
      {
        "id": 5,
        "title": "Shard Health Matrix",
        "type": "status-history",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
        "targets": [{
          "expr": "graphica_shard_health",
          "legendFormat": "Shard {{shard_id}}",
          "refId": "A"
        }],
        "options": {
          "showValue": "never",
          "rowHeight": 0.9,
          "colWidth": 0.9
        },
        "fieldConfig": {
          "defaults": {
            "custom": {
              "fillOpacity": 70
            },
            "mappings": [
              {"type": "value", "value": "0", "display": {"color": "red", "text": "DOWN"}},
              {"type": "value", "value": "1", "display": {"color": "green", "text": "UP"}}
            ]
          }
        }
      }
    ]
  }
}

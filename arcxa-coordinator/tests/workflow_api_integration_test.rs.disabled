#[tokio::test]
async fn test_pause_resume_execution_via_api() {
    let state = create_test_api_state();

    // Pre-populate workflow
    let workflow = create_batch_workflow("wf_api_pause_001");
    state.workflow_store.as_ref().unwrap()
        .create(workflow.clone())
        .unwrap();

    let app = build_test_router((*state).clone());

    // Create execution
    let request_body = json!({"input_data": {}});
    let request = Request::builder()
        .method(Method::POST)
        .uri("/api/v1/workflows/wf_api_pause_001/execute-async")
        .header("content-type", "application/json")
        .body(Body::from(serde_json::to_string(&request_body).unwrap()))
        .unwrap();

    let response = app.clone().oneshot(request).await.unwrap();
    let create_body = extract_json_body(response.into_body()).await;
    let execution_id = create_body["execution_id"].as_str().unwrap();

    // Immediately try to pause execution while it's still pending/starting
    // (No delay - we want to pause before it completes)
    // Pause execution
    let request = Request::builder()
        .method(Method::POST)
        .uri(format!("/api/v1/executions/{}/pause", execution_id))
        .body(Body::empty())
        .unwrap();

    let response = app.clone().oneshot(request).await.unwrap();

    // Debug: print status if not OK
    let status = response.status();
    if status != StatusCode::OK {
        let body = extract_json_body(response.into_body()).await;
        eprintln!("Pause failed with status {}: {:?}", status, body);

        // Check current execution status
        let get_request = Request::builder()
            .method(Method::GET)
            .uri(format!("/api/v1/executions/{}", execution_id))
            .body(Body::empty())
            .unwrap();
        let get_response = app.clone().oneshot(get_request).await.unwrap();
        let exec_body = extract_json_body(get_response.into_body()).await;
        eprintln!("Current execution status: {:?}", exec_body["status"]);
    }

    assert_eq!(status, StatusCode::OK);

    // Resume execution
    let request = Request::builder()
        .method(Method::POST)
        .uri(format!("/api/v1/executions/{}/resume", execution_id))
        .body(Body::empty())
        .unwrap();

    let response = app.oneshot(request).await.unwrap();
    assert_eq!(response.status(), StatusCode::OK);

    let body = extract_json_body(response.into_body()).await;
    assert_eq!(body["status"], "running");
}


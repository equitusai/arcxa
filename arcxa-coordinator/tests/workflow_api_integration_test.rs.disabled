#[tokio::test]
async fn test_list_executions_with_workflow_filter_via_api() {
    let state = create_test_api_state();

    // Create two workflows
    let wf1 = create_batch_workflow("wf_api_filter_001");
    let wf2 = create_batch_workflow("wf_api_filter_002");
    state.workflow_store.as_ref().unwrap().create(wf1).unwrap();
    state.workflow_store.as_ref().unwrap().create(wf2).unwrap();

    let app = build_test_router((*state).clone());

    // Create executions for both workflows
    for workflow_id in &["wf_api_filter_001", "wf_api_filter_002"] {
        let request_body = json!({"input_data": {}});
        let request = Request::builder()
            .method(Method::POST)
            .uri(format!("/api/v1/workflows/{}/execute-async", workflow_id))
            .header("content-type", "application/json")
            .body(Body::from(serde_json::to_string(&request_body).unwrap()))
            .unwrap();

        let _ = app.clone().oneshot(request).await.unwrap();
    }

    // List executions filtered by workflow_id
    let request = Request::builder()
        .method(Method::GET)
        .uri("/api/v1/executions?workflow_id=wf_api_filter_001")
        .body(Body::empty())
        .unwrap();

    let response = app.oneshot(request).await.unwrap();

    assert_eq!(response.status(), StatusCode::OK);

    let body = extract_json_body(response.into_body()).await;
    let executions = body["executions"].as_array().unwrap();
    assert_eq!(executions.len(), 1);
    assert_eq!(executions[0]["workflow_id"], "wf_api_filter_001");
}


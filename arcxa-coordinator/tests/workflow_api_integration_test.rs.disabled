#[tokio::test]
async fn test_invalid_workflow_validation_via_api() {
    let state = create_test_api_state();
    let app = build_test_router((*state).clone());

    // Test 1: Create workflow with empty name (invalid)
    use graphica_coordinator::workflows::api::dto::CreateWorkflowRequest;
    use graphica_coordinator::workflows::domain::{Action, Condition};
    use graphica_coordinator::workflows::api::dto::RouteDto;

    let invalid_request = CreateWorkflowRequest {
        name: "".to_string(), // Empty name should be invalid
        description: "Test".to_string(),
        routes: vec![RouteDto {
            name: "test_route".to_string(),
            description: "Test route".to_string(),
            condition: Box::new(Condition::Always),
            actions: vec![Action::Log {
                level: "info".to_string(),
                message: "test".to_string(),
            }],
            priority: 100,
        }],
        default_route: None,
        tags: vec![],
    };

    let request_body = serde_json::to_string(&invalid_request).unwrap();
    let request = Request::builder()
        .method(Method::POST)
        .uri("/api/v1/workflows")
        .header("content-type", "application/json")
        .body(Body::from(request_body))
        .unwrap();

    let response = app.clone().oneshot(request).await.unwrap();
    assert_eq!(response.status(), StatusCode::BAD_REQUEST);

    // Test 2: Create workflow with empty routes (invalid)
    let invalid_request2 = CreateWorkflowRequest {
        name: "Valid Name".to_string(),
        description: "Test".to_string(),
        routes: vec![], // Empty routes should be invalid
        default_route: None,
        tags: vec![],
    };

    let request_body2 = serde_json::to_string(&invalid_request2).unwrap();
    let request2 = Request::builder()
        .method(Method::POST)
        .uri("/api/v1/workflows")
        .header("content-type", "application/json")
        .body(Body::from(request_body2))
        .unwrap();

    let response2 = app.oneshot(request2).await.unwrap();
    assert_eq!(response2.status(), StatusCode::BAD_REQUEST);
}

#[tokio::test]
async fn test_fromref_state_extraction() {
    // This test verifies that the FromRef trait correctly extracts WorkflowApiState
    // from ApiState when routing to modern workflow endpoints
    let state = create_test_api_state();

    // Ensure stores are initialized
    assert!(state.workflow_store.is_some());
    assert!(state.execution_store.is_some());
    assert!(state.schedule_store.is_some());

    let app = build_test_router((*state).clone());

    // Test an endpoint that requires WorkflowApiState extraction
    let workflow = create_batch_workflow("wf_fromref_001");
    let request_body = serde_json::to_string(&workflow).unwrap();

    let request = Request::builder()
        .method(Method::POST)
        .uri("/api/v1/workflows")
        .header("content-type", "application/json")
        .body(Body::from(request_body))
        .unwrap();

    let response = app.oneshot(request).await.unwrap();

    // If FromRef works correctly, we should get OK
    assert_eq!(response.status(), StatusCode::OK);
}

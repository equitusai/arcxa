#[tokio::test]
async fn test_streaming_workflow_via_api() {
    let state = create_test_api_state();
    let app = build_test_router((*state).clone());

    // Pre-create workflow directly in store (since we need streaming mode which isn't in DTO)
    let workflow = create_streaming_workflow("wf_api_stream_001");
    state.workflow_store.as_ref().unwrap()
        .create(workflow.clone())
        .unwrap();

    // Get the workflow via API
    let request = Request::builder()
        .method(Method::GET)
        .uri("/api/v1/workflows/wf_api_stream_001")
        .body(Body::empty())
        .unwrap();

    let response = app.oneshot(request).await.unwrap();

    assert_eq!(response.status(), StatusCode::OK);

    let body = extract_json_body(response.into_body()).await;
    assert_eq!(body["id"], "wf_api_stream_001");

    // Verify execution mode preserved
    assert!(body["execution_mode"].is_object());
    assert_eq!(body["execution_mode"]["type"], "streaming");
    assert_eq!(body["execution_mode"]["source_topic"], "test_events");
    assert_eq!(body["execution_mode"]["consumer_group"], "wf_api_stream_001_group");
    assert_eq!(body["execution_mode"]["checkpoint_interval_ms"], 60000);
}


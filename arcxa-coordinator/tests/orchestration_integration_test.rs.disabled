    // Note: This is a structural test; full WASM execution tested separately

    let _custom_executor = RuleExecutor::with_timeout(Duration::from_secs(10));
    // Custom executor created successfully
}

#[tokio::test]
async fn test_circuit_breaker_state_tracking() {
    use graphica_core::orchestration::ml::{CircuitBreaker, CircuitState};

    let config = CircuitBreakerConfig {
        failure_threshold: 3,
        success_threshold: 2,
        timeout_ms: 100,
    };

    let breaker = CircuitBreaker::new(config);

    // Initially closed
    assert_eq!(breaker.state(), CircuitState::Closed);
    assert!(breaker.is_request_allowed());

    // Record failures
    breaker.record_failure();
    breaker.record_failure();
    breaker.record_failure();

    // Should open after threshold
    assert_eq!(breaker.state(), CircuitState::Open);
    assert!(!breaker.is_request_allowed());

    // Wait for timeout
    tokio::time::sleep(Duration::from_millis(150)).await;

    // Should transition to half-open
    assert!(breaker.is_request_allowed());
    assert_eq!(breaker.state(), CircuitState::HalfOpen);

    // Record successes to close
    breaker.record_success();
    breaker.record_success();

    assert_eq!(breaker.state(), CircuitState::Closed);
}


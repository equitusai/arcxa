// REAL END-TO-END BITEMPORAL INTEGRATION TEST
//
// This test PROVES that the integration actually works:
// 1. RDF-star triple inserted → automatically indexed in TemporalIndexes
// 2. Can query via indexes (not just SPARQL)
// 3. Version superseding updates indexes
// 4. Integration is REAL, not just parallel systems

use chrono::Utc;
use graphica_coordinator::governance::bitemporal::TransactionId;
use graphica_coordinator::governance::rdf_star::AnnotatedTriple;
use graphica_coordinator::governance::rdf_store::{GraphicaRdfStore, RdfStore};
use tempfile::TempDir;

#[test]
fn test_auto_indexing_on_insert() {
    println!("\n=== TEST: Auto-Indexing on RDF-Star Insert ===");

    // 1. Create RDF store WITH temporal indexes
    let temp_dir = TempDir::new().unwrap();
    let store = GraphicaRdfStore::new_in_memory()
        .unwrap()
        .with_temporal_indexes(temp_dir.path().join("indexes"))
        .unwrap();

    println!("✓ Created RDF store with temporal indexes enabled");

    // Verify indexes are available
    let indexes = store.temporal_indexes()
        .expect("Temporal indexes should be available");

    println!("✓ Temporal indexes accessible");

    // 2. Create a bitemporal triple
    let tx_id = TransactionId::new(1, Utc::now(), 1);
    let triple = AnnotatedTriple::new(
        "http://example.org/entity/customer_123",
        "http://example.org/prop/revenue",
        "500000",
    )
    .with_valid_time(Utc::now(), None)
    .with_transaction_time(&tx_id, None)
    .with_confidence(0.92);

    println!("✓ Created bitemporal triple with txId={}, nodeId={}", tx_id.seq, tx_id.node_id);

    // 3. Insert into RDF store - should AUTO-INDEX
    store.insert_rdf_star_triple(&triple, None)
        .expect("Insert should succeed");

    println!("✓ Inserted RDF-star triple");

    // 4. CRITICAL TEST: Verify the triple was AUTO-INDEXED
    let current_version = indexes
        .find_current_version(
            "http://example.org/entity/customer_123",
            "http://example.org/prop/revenue"
        )
        .expect("Index lookup should succeed");

    assert!(current_version.is_some(), "❌ INTEGRATION FAILED: Triple was NOT auto-indexed!");
    println!("✅ INTEGRATION SUCCESS: Triple was auto-indexed!");

    let version = current_version.unwrap();
    assert_eq!(version.subject, "http://example.org/entity/customer_123");
    assert_eq!(version.predicate, "http://example.org/prop/revenue");
    assert_eq!(version.object, "500000");
    assert!(version.is_current(), "Version should be current");

    println!("✅ Indexed version has correct data:");
    println!("   - Subject: {}", version.subject);
    println!("   - Predicate: {}", version.predicate);
    println!("   - Object: {}", version.object);
    println!("   - Is Current: {}", version.is_current());

    println!("\n🎉 AUTO-INDEXING INTEGRATION TEST PASSED!");
}

#[test]
fn test_multiple_versions_auto_indexed() {
    println!("\n=== TEST: Multiple Versions Auto-Indexed ===");

    let temp_dir = TempDir::new().unwrap();
    let store = GraphicaRdfStore::new_in_memory()
        .unwrap()
        .with_temporal_indexes(temp_dir.path().join("indexes"))
        .unwrap();

    let indexes = store.temporal_indexes().unwrap();

    let subject = "http://example.org/entity/product_456";
    let predicate = "http://example.org/prop/price";

    // Insert version 1
    let tx1 = TransactionId::new(1, Utc::now(), 1);
    let triple_v1 = AnnotatedTriple::new(subject, predicate, "100")
        .with_valid_time(Utc::now(), None)
        .with_transaction_time(&tx1, None);

    store.insert_rdf_star_triple(&triple_v1, None).unwrap();
    println!("✓ Inserted version 1 (price=100)");

    // Verify v1 is indexed and current
    let current = indexes.find_current_version(subject, predicate).unwrap();
    assert!(current.is_some());
    assert_eq!(current.unwrap().object, "100");
    println!("✓ Version 1 is current in indexes");

    std::thread::sleep(std::time::Duration::from_millis(10));

    // Insert version 2
    let tx2 = TransactionId::new(2, Utc::now(), 1);
    let triple_v2 = AnnotatedTriple::new(subject, predicate, "150")
        .with_valid_time(Utc::now(), None)
        .with_transaction_time(&tx2, None);

    store.insert_rdf_star_triple(&triple_v2, None).unwrap();
    println!("✓ Inserted version 2 (price=150)");

    // Verify v2 is now current
    let current = indexes.find_current_version(subject, predicate).unwrap();
    assert!(current.is_some());
    assert_eq!(current.unwrap().object, "150");
    println!("✓ Version 2 is now current in indexes");

    // Verify version chain has both versions
    let chain = indexes.get_version_chain(subject, predicate).unwrap();
    assert_eq!(chain.len(), 2, "Should have 2 versions in chain");
    println!("✓ Version chain has {} versions", chain.len());

    println!("\n🎉 MULTI-VERSION AUTO-INDEXING TEST PASSED!");
}

#[test]
fn test_non_bitemporal_triple_not_indexed() {
    println!("\n=== TEST: Non-Bitemporal Triples Not Indexed ===");

    let temp_dir = TempDir::new().unwrap();
    let store = GraphicaRdfStore::new_in_memory()
        .unwrap()
        .with_temporal_indexes(temp_dir.path().join("indexes"))
        .unwrap();

    let indexes = store.temporal_indexes().unwrap();

    // Insert a triple WITHOUT bitemporal annotations
    let triple = AnnotatedTriple::new(
        "http://example.org/entity/test",
        "http://example.org/prop/name",
        "Test Entity",
    )
    .with_confidence(0.95); // Only confidence, no temporal annotations

    store.insert_rdf_star_triple(&triple, None).unwrap();
    println!("✓ Inserted non-bitemporal triple");

    // Verify it's NOT indexed (because it lacks bitemporal annotations)
    let current = indexes.find_current_version(
        "http://example.org/entity/test",
        "http://example.org/prop/name"
    ).unwrap();

    assert!(current.is_none(), "Non-bitemporal triple should NOT be indexed");
    println!("✓ Non-bitemporal triple correctly NOT indexed");

    println!("\n🎉 SELECTIVE INDEXING TEST PASSED!");
}

#[test]
fn test_indexes_disabled_by_default() {
    println!("\n=== TEST: Indexes Disabled by Default (Backward Compat) ===");

    // Create store WITHOUT enabling temporal indexes
    let store = GraphicaRdfStore::new_in_memory().unwrap();

    // Verify indexes are None
    assert!(store.temporal_indexes().is_none(), "Indexes should be disabled by default");
    println!("✓ Temporal indexes disabled by default");

    // Insert bitemporal triple - should still work, just not indexed
    let tx_id = TransactionId::new(1, Utc::now(), 1);
    let triple = AnnotatedTriple::new(
        "http://example.org/entity/test",
        "http://example.org/prop/value",
        "123",
    )
    .with_valid_time(Utc::now(), None)
    .with_transaction_time(&tx_id, None);

    // Should not fail even without indexes
    store.insert_rdf_star_triple(&triple, None).unwrap();
    println!("✓ Insert works without indexes enabled");

    println!("\n🎉 BACKWARD COMPATIBILITY TEST PASSED!");
}

#[test]
fn test_end_to_end_bitemporal_flow() {
    println!("\n=== TEST: Complete End-to-End Bitemporal Flow ===");

    let temp_dir = TempDir::new().unwrap();
    let store = GraphicaRdfStore::new_in_memory()
        .unwrap()
        .with_temporal_indexes(temp_dir.path().join("indexes"))
        .unwrap();

    let indexes = store.temporal_indexes().unwrap();

    let subject = "http://example.org/entity/account_789";
    let predicate = "http://example.org/prop/balance";

    // Step 1: Insert initial version
    let tx1 = TransactionId::new(1, Utc::now(), 1);
    let v1_time = Utc::now();
    let triple_v1 = AnnotatedTriple::new(subject, predicate, "10000")
        .with_valid_time(v1_time, None)
        .with_transaction_time(&tx1, None)
        .with_confidence(0.99);

    store.insert_rdf_star_triple(&triple_v1, None).unwrap();
    println!("✓ Step 1: Inserted v1 (balance=10000)");

    // Verify in RDF store via SPARQL
    let sparql_query = format!(r#"
        PREFIX gph: <http://graphica.io/ontology#>
        SELECT ?balance WHERE {{
            <{}> <{}> ?balance .
        }}
    "#, subject, predicate);

    let sparql_results = store.query(&sparql_query).unwrap();
    assert_eq!(sparql_results.len(), 1);
    println!("✓ Step 2: Verified in RDF store via SPARQL");

    // Verify in temporal indexes
    let indexed_v1 = indexes.find_current_version(subject, predicate).unwrap();
    assert!(indexed_v1.is_some());
    assert_eq!(indexed_v1.as_ref().unwrap().object, "10000");
    println!("✓ Step 3: Verified in temporal indexes");

    std::thread::sleep(std::time::Duration::from_millis(10));

    // Step 4: Insert updated version
    let tx2 = TransactionId::new(2, Utc::now(), 1);
    let v2_time = Utc::now();
    let triple_v2 = AnnotatedTriple::new(subject, predicate, "15000")
        .with_valid_time(v2_time, None)
        .with_transaction_time(&tx2, None)
        .with_confidence(0.99);

    store.insert_rdf_star_triple(&triple_v2, None).unwrap();
    println!("✓ Step 4: Inserted v2 (balance=15000)");

    // Verify current version updated in indexes
    let current = indexes.find_current_version(subject, predicate).unwrap();
    assert!(current.is_some());
    assert_eq!(current.unwrap().object, "15000");
    println!("✓ Step 5: Current version updated in indexes");

    // Verify both versions exist in RDF store
    let rdf_star_query = format!(r#"
        PREFIX gph: <http://graphica.io/ontology#>
        SELECT ?balance ?txId WHERE {{
            << <{}> <{}> ?balance >> gph:txId ?txId .
        }}
        ORDER BY ?txId
    "#, subject, predicate);

    let rdf_results = store.query(&rdf_star_query).unwrap();
    assert_eq!(rdf_results.len(), 2, "Should have 2 annotated versions in RDF store");
    println!("✓ Step 6: Both versions exist in RDF store");

    // Verify version chain in indexes
    let chain = indexes.get_version_chain(subject, predicate).unwrap();
    assert_eq!(chain.len(), 2);
    assert_eq!(chain[0].object, "10000");
    assert_eq!(chain[1].object, "15000");
    println!("✓ Step 7: Version chain complete with 2 versions");

    println!("\n🎉🎉🎉 COMPLETE END-TO-END INTEGRATION TEST PASSED! 🎉🎉🎉");
    println!("    ✓ RDF Store and Temporal Indexes are TRULY INTEGRATED!");
    println!("    ✓ Auto-indexing works!");
    println!("    ✓ Queries work through both systems!");
    println!("    ✓ Version management functional!");
}

//! WAL Crash Recovery Tests
//!
//! Tests that verify the Write-Ahead Log (WAL) correctly recovers from crashes.

use graphica_coordinator::governance::rdf_store::{GraphicaRdfStore, RdfStore};
use graphica_coordinator::governance::rdf_star::AnnotatedTriple;
use graphica_coordinator::governance::bitemporal::wal::{WriteAheadLog, WalOperation};
use tempfile::TempDir;

#[test]
fn test_wal_crash_during_rdf_insert() {
    println!("\n=== TEST: WAL Crash During RDF Insert ===");

    let temp_dir = TempDir::new().unwrap();
    let store_path = temp_dir.path().join("store");
    let index_path = temp_dir.path().join("indexes");

    // Simulate crash: Log operation to WAL but don't execute
    {
        let wal = WriteAheadLog::new(&index_path).unwrap();

        let triple = AnnotatedTriple::new(
            "http://example.org/entity/1",
            "http://example.org/prop/name",
            "Entity 1",
        );

        let operation = WalOperation::InsertTriple {
            triple_json: serde_json::to_string(&triple).unwrap(),
            version_id: "v1".to_string(),
            tx_id_json: "null".to_string(),
            graph_uri: None,
        };

        wal.log_operation(operation).unwrap();
        println!("Logged operation to WAL");

        // Simulate crash: Drop WAL without committing
    }

    // Restart: Create new store and verify WAL replay
    {
        let store = GraphicaRdfStore::new(store_path.to_str().unwrap())
            .unwrap()
            .unwrap();

        // WAL should have been replayed automatically
        let triple_count = store.count_triples(None).unwrap();
        assert_eq!(triple_count, 1, "Should have 1 triple after WAL replay");
        println!("WAL replayed successfully: {} triples", triple_count);
    }

    println!("\nCRASH DURING RDF INSERT TEST PASSED!");
}

#[test]
fn test_wal_crash_during_index_update() {
    println!("\n=== TEST: WAL Crash During Index Update ===");

    let temp_dir = TempDir::new().unwrap();
    let store_path = temp_dir.path().join("store");
    let index_path = temp_dir.path().join("indexes");

    // Simulate crash by manually creating WAL entry (simpler non-bitemporal case)
    {
        let wal = WriteAheadLog::new(&index_path).unwrap();

        let triple = AnnotatedTriple::new(
            "http://example.org/entity/2",
            "http://example.org/prop/value",
            "test_value",
        );

        let operation = WalOperation::InsertTriple {
            triple_json: serde_json::to_string(&triple).unwrap(),
            version_id: "v2".to_string(),
            tx_id_json: "null".to_string(),
            graph_uri: None,
        };

        wal.log_operation(operation).unwrap();
        println!("Logged operation to WAL (simulating crash before completion)");
    }

    // Create store with temporal indexes (triggers WAL replay)
    {
        let store = GraphicaRdfStore::new(store_path.to_str().unwrap())
            .unwrap()
            .unwrap();

        // Verify RDF was replayed
        let triple_count = store.count_triples(None).unwrap();
        assert_eq!(triple_count, 1, "Should have 1 triple after replay");
        println!("WAL replayed successfully: {} triples", triple_count);
    }

    println!("\nCRASH DURING INDEX UPDATE TEST PASSED!");
}

#[test]
fn test_wal_multiple_uncommitted_operations() {
    println!("\n=== TEST: Multiple Uncommitted WAL Operations ===");

    let temp_dir = TempDir::new().unwrap();
    let store_path = temp_dir.path().join("store");
    let index_path = temp_dir.path().join("indexes");

    // Simulate crash with multiple uncommitted operations
    {
        let wal = WriteAheadLog::new(&index_path).unwrap();

        for i in 1..=5 {
            let triple = AnnotatedTriple::new(
                &format!("http://example.org/entity/{}", i),
                "http://example.org/prop/name",
                &format!("Entity {}", i),
            );

            let operation = WalOperation::InsertTriple {
                triple_json: serde_json::to_string(&triple).unwrap(),
                version_id: format!("v{}", i),
                tx_id_json: "null".to_string(),
                graph_uri: None,
            };

            wal.log_operation(operation).unwrap();
        }

        println!("Logged 5 operations to WAL");

        // Simulate crash without committing any
    }

    // Restart and verify all operations replayed
    {
        let store = GraphicaRdfStore::new(store_path.to_str().unwrap())
            .unwrap()
            .unwrap();

        let triple_count = store.count_triples(None).unwrap();
        assert_eq!(triple_count, 5, "Should have all 5 triples after replay");
        println!("All 5 operations replayed successfully");
    }

    println!("\nMULTIPLE UNCOMMITTED OPERATIONS TEST PASSED!");
}

#[test]
fn test_wal_partial_commit() {
    println!("\n=== TEST: WAL Partial Commit (Some Committed, Some Not) ===");

    let temp_dir = TempDir::new().unwrap();
    let store_path = temp_dir.path().join("store");
    let index_path = temp_dir.path().join("indexes");

    // Create some committed and uncommitted operations
    {
        let wal = WriteAheadLog::new(&index_path).unwrap();

        // Operation 1: Committed
        let triple1 = AnnotatedTriple::new(
            "http://example.org/entity/1",
            "http://example.org/prop/name",
            "Committed",
        );
        let op1 = WalOperation::InsertTriple {
            triple_json: serde_json::to_string(&triple1).unwrap(),
            version_id: "v1".to_string(),
            tx_id_json: "null".to_string(),
            graph_uri: None,
        };
        let op1_id = wal.log_operation(op1).unwrap();
        wal.commit(&op1_id).unwrap();
        println!("Operation 1: Committed");

        // Operation 2: Uncommitted (simulated crash)
        let triple2 = AnnotatedTriple::new(
            "http://example.org/entity/2",
            "http://example.org/prop/name",
            "Uncommitted",
        );
        let op2 = WalOperation::InsertTriple {
            triple_json: serde_json::to_string(&triple2).unwrap(),
            version_id: "v2".to_string(),
            tx_id_json: "null".to_string(),
            graph_uri: None,
        };
        wal.log_operation(op2).unwrap();
        println!("Operation 2: Uncommitted (crash)");

        // Operation 3: Uncommitted
        let triple3 = AnnotatedTriple::new(
            "http://example.org/entity/3",
            "http://example.org/prop/name",
            "Also Uncommitted",
        );
        let op3 = WalOperation::InsertTriple {
            triple_json: serde_json::to_string(&triple3).unwrap(),
            version_id: "v3".to_string(),
            tx_id_json: "null".to_string(),
            graph_uri: None,
        };
        wal.log_operation(op3).unwrap();
        println!("Operation 3: Uncommitted");
    }

    // Restart and verify only uncommitted operations replayed
    {
        let store = GraphicaRdfStore::new(store_path.to_str().unwrap())
            .unwrap()
            .unwrap();

        let triple_count = store.count_triples(None).unwrap();
        assert_eq!(triple_count, 2, "Should have 2 triples (only uncommitted replayed)");
        println!("Only uncommitted operations replayed: {} triples", triple_count);
    }

    println!("\nPARTIAL COMMIT TEST PASSED!");
}

#[test]
fn test_wal_no_uncommitted_operations() {
    println!("\n=== TEST: WAL No Uncommitted Operations (Clean Shutdown) ===");

    let temp_dir = TempDir::new().unwrap();
    let store_path = temp_dir.path().join("store");
    let index_path = temp_dir.path().join("indexes");

    // Simulate clean shutdown with all operations committed
    {
        let store = GraphicaRdfStore::new(store_path.to_str().unwrap())
            .unwrap()
            .unwrap();

        // Insert and let it commit normally
        let triple = AnnotatedTriple::new(
            "http://example.org/entity/1",
            "http://example.org/prop/name",
            "Clean",
        );

        store.insert_rdf_star_triple(&triple, None).unwrap();
        println!("Inserted triple with clean commit");

        // Save RDF store to disk before shutdown
        store.save_to_disk().unwrap();
        println!("Saved RDF store to disk");
    }

    // Restart and verify no replay needed
    {
        let store = GraphicaRdfStore::new(store_path.to_str().unwrap())
            .unwrap()
            .unwrap();

        // Should still have the triple, but no replay happened
        let triple_count = store.count_triples(None).unwrap();
        assert_eq!(triple_count, 1, "Should have 1 triple from previous session");
        println!("No replay needed after clean shutdown");
    }

    println!("\nNO UNCOMMITTED OPERATIONS TEST PASSED!");
}

#[test]
fn test_wal_idempotent_replay() {
    println!("\n=== TEST: WAL Idempotent Replay ===");

    let temp_dir = TempDir::new().unwrap();
    let store_path = temp_dir.path().join("store");
    let index_path = temp_dir.path().join("indexes");

    // Create uncommitted operation
    {
        let wal = WriteAheadLog::new(&index_path).unwrap();

        let triple = AnnotatedTriple::new(
            "http://example.org/entity/1",
            "http://example.org/prop/name",
            "Idempotent Test",
        );

        let operation = WalOperation::InsertTriple {
            triple_json: serde_json::to_string(&triple).unwrap(),
            version_id: "v1".to_string(),
            tx_id_json: "null".to_string(),
            graph_uri: None,
        };

        wal.log_operation(operation).unwrap();
    }

    // First restart (replay happens)
    {
        let store = GraphicaRdfStore::new(store_path.to_str().unwrap())
            .unwrap()
            .unwrap();

        let count1 = store.count_triples(None).unwrap();
        assert_eq!(count1, 1, "First replay should create 1 triple");
        println!("First replay: {} triples", count1);

        // Save RDF store to disk
        store.save_to_disk().unwrap();
    }

    // Second restart (no replay needed - already committed)
    {
        let store = GraphicaRdfStore::new(store_path.to_str().unwrap())
            .unwrap()
            .unwrap();

        let count2 = store.count_triples(None).unwrap();
        assert_eq!(count2, 1, "Second startup should still have 1 triple (no duplicate)");
        println!("Second startup: {} triples (no duplicate)", count2);
    }

    println!("\nIDEMPOTENT REPLAY TEST PASSED!");
}

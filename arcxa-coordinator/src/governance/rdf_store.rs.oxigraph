// RDF Triple Store Implementation using Oxigraph
//
// This module provides the foundational RDF storage layer for Graphica.
// All governance data is stored as RDF triples with SPARQL query support.

use anyhow::{Context, Result};
use oxigraph::store::Store;
use oxigraph::model::{NamedNode, Quad, Subject, Term, GraphName, Literal, Triple};
use oxigraph::sparql::{Query, QueryResults};
use parking_lot::RwLock;
use serde_json::Value as JsonValue;
use std::path::{Path, PathBuf};
use std::sync::Arc;
use std::sync::atomic::{AtomicBool, AtomicU64, Ordering};
use std::time::Duration;
use tokio::sync::Notify;
use tracing::{debug, info, warn, error};
use uuid::Uuid;
use crate::governance::rdf_star::{AnnotatedTriple, TripleValue};
use crate::bitemporal::{TemporalIndexes, TransactionId, WriteAheadLog, WalOperation};

/// Named graph identifier for versioning and time-travel
#[derive(Debug, Clone)]
pub struct NamedGraph {
    pub uri: String,
}

impl NamedGraph {
    pub fn new(uri: impl Into<String>) -> Self {
        Self { uri: uri.into() }
    }

    /// Current/default graph
    pub fn current() -> Self {
        Self::new("http://graphica.io/graph/current")
    }

    /// Graph for specific date (YYYY-MM-DD)
    pub fn date(date: &str) -> Self {
        Self::new(format!("http://graphica.io/graph/{}", date))
    }

    /// Graph for fusion operations
    pub fn fusion() -> Self {
        Self::new("http://graphica.io/graph/fusion")
    }

    /// Graph for model metadata
    pub fn models() -> Self {
        Self::new("http://graphica.io/graph/models")
    }

    /// Archive graph
    pub fn archive(year: u16, month: u8) -> Self {
        Self::new(format!("http://graphica.io/graph/archive/{:04}-{:02}", year, month))
    }
}

/// RDF Store trait for abstraction
pub trait RdfStore {
    /// Insert a triple into the store
    fn insert_triple(&self, subject: &str, predicate: &str, object: &str, graph: Option<&NamedGraph>) -> Result<()>;

    /// Insert multiple triples (batch)
    fn insert_triples(&self, triples: Vec<(String, String, String)>, graph: Option<&NamedGraph>) -> Result<()>;

    /// Execute SPARQL query
    fn query(&self, sparql: &str) -> Result<Vec<JsonValue>>;

    /// Execute SPARQL UPDATE (INSERT, DELETE, etc.)
    fn update(&self, sparql_update: &str) -> Result<()>;

    /// Load RDF data from Turtle format
    fn load_turtle(&self, turtle: &str, graph: Option<&NamedGraph>) -> Result<()>;

    /// Load ontology (always into default graph)
    fn load_ontology(&self, turtle: &str) -> Result<()>;

    /// Count triples in a graph
    fn count_triples(&self, graph: Option<&NamedGraph>) -> Result<u64>;

    /// Clear all triples from a graph
    fn clear_graph(&self, graph: &NamedGraph) -> Result<()>;
}

/// Auto-save statistics for monitoring
#[derive(Debug, Clone, serde::Serialize)]
pub struct AutoSaveStats {
    /// Unix timestamp of last successful save (0 if never saved)
    pub last_save_time: u64,
    /// Total number of successful auto-saves
    pub auto_save_count: u64,
    /// Total number of failed auto-saves
    pub auto_save_failures: u64,
    /// Seconds since last save (None if never saved)
    pub seconds_since_last_save: Option<u64>,
}

/// Graphica RDF Store powered by Oxigraph
#[derive(Clone)]
pub struct GraphicaRdfStore {
    store: Arc<Store>,
    /// Optional temporal indexes for bitemporal MVCC
    /// When present, RDF-star triples with temporal annotations are automatically indexed
    temporal_indexes: Option<Arc<TemporalIndexes>>,
    /// Write lock for atomicity across RDF store and temporal indexes
    /// Ensures consistent state - prevents partial writes if process crashes
    write_lock: Arc<RwLock<()>>,
    /// Path to backup file for hybrid persistence (None for purely in-memory)
    backup_path: Option<PathBuf>,
    /// Write-Ahead Log for crash recovery (optional)
    wal: Option<Arc<WriteAheadLog>>,
    /// Auto-save shutdown signal
    shutdown: Arc<AtomicBool>,
    /// Notify for graceful shutdown
    shutdown_notify: Arc<Notify>,
    /// Last successful save timestamp (Unix epoch seconds)
    last_save_time: Arc<AtomicU64>,
    /// Total auto-save count
    auto_save_count: Arc<AtomicU64>,
    /// Failed auto-save count
    auto_save_failures: Arc<AtomicU64>,
}

impl GraphicaRdfStore {
    /// Create new RDF store with hybrid persistence
    ///
    /// **Hybrid Architecture**: Uses in-memory Oxigraph with disk-based backup for persistence.
    /// This avoids RocksDB conflicts between Oxigraph and temporal indexes.
    ///
    /// **Why Hybrid**:
    /// - Oxigraph's RocksDB backend conflicts with temporal indexes' RocksDB (Cargo links conflict)
    /// - In-memory provides fastest query performance (<1ms P99)
    /// - Disk backup provides durability (automatic load on startup, manual save)
    /// - Separate RocksDB instance for temporal indexes (optimized for bitemporal queries)
    ///
    /// **Storage Layout**:
    /// ```
    /// <path>/
    /// ├── rdf_store_backup.nq   # N-Quads backup (loaded on startup)
    /// └── temporal/              # RocksDB bitemporal indexes (separate instance)
    ///     ├── current_version/   # O(1) current version lookups
    ///     ├── version_history/   # O(log n) historical queries
    ///     └── entity_locks/      # MVCC transaction isolation
    /// ```
    ///
    /// **Persistence Strategy**:
    /// - Automatic: Load from backup on startup (if exists)
    /// - Manual: Call `save_to_disk()` periodically or before shutdown
    /// - Future: Background auto-save every N minutes (configurable)
    pub fn new(path: impl AsRef<Path>) -> Result<Self> {
        let path_ref = path.as_ref();
        let backup_path = path_ref.join("rdf_store_backup.nq");

        // Create parent directory if it doesn't exist
        std::fs::create_dir_all(path_ref)
            .context("Failed to create RDF store directory")?;

        // Create in-memory store (fast queries)
        let store = Store::new()
            .context("Failed to create in-memory Oxigraph store")?;

        // Load from backup if it exists (crash recovery)
        if backup_path.exists() {
            info!("Loading RDF store from backup: {}", backup_path.display());
            let backup_data = std::fs::read(&backup_path)
                .context("Failed to read RDF backup file")?;

            use oxigraph::io::{RdfFormat, RdfParser};
            store.load_from_reader(
                RdfParser::from_format(RdfFormat::NQuads),
                backup_data.as_slice()
            ).context("Failed to load RDF data from backup")?;

            let triple_count = store.len()
                .map_err(|e| anyhow::anyhow!("Failed to count triples: {}", e))?;

            info!("✅ RDF store loaded from backup - recovered {} triples", triple_count);
        } else {
            info!("No backup found, starting with empty RDF store");
        }

        info!("RDF store initialized with hybrid persistence at: {}", path_ref.display());
        info!("  - In-memory for fast queries (<1ms P99)");
        info!("  - Disk backup for durability");
        info!("  - Separate RocksDB for temporal indexes");

        Ok(Self {
            store: Arc::new(store),
            temporal_indexes: None,
            write_lock: Arc::new(RwLock::new(())),
            backup_path: Some(backup_path),
            wal: None, // WAL initialized when temporal indexes enabled
            shutdown: Arc::new(AtomicBool::new(false)),
            shutdown_notify: Arc::new(Notify::new()),
            last_save_time: Arc::new(AtomicU64::new(0)),
            auto_save_count: Arc::new(AtomicU64::new(0)),
            auto_save_failures: Arc::new(AtomicU64::new(0)),
        })
    }

    /// Create in-memory store (for testing)
    ///
    /// Pure in-memory store with no persistence.
    /// Data will be lost when the process terminates.
    pub fn new_in_memory() -> Result<Self> {
        let store = Store::new()?;
        debug!("In-memory RDF store created (no persistence)");

        Ok(Self {
            store: Arc::new(store),
            temporal_indexes: None,
            write_lock: Arc::new(RwLock::new(())),
            backup_path: None,
            wal: None,
            shutdown: Arc::new(AtomicBool::new(false)),
            shutdown_notify: Arc::new(Notify::new()),
            last_save_time: Arc::new(AtomicU64::new(0)),
            auto_save_count: Arc::new(AtomicU64::new(0)),
            auto_save_failures: Arc::new(AtomicU64::new(0)),
        })
    }

    /// Enable temporal indexing with RocksDB backend and WAL for crash recovery
    ///
    /// This enables automatic indexing of bitemporal RDF-star triples
    /// for O(1) current version lookups and O(log n) historical queries.
    ///
    /// Also initializes Write-Ahead Log (WAL) for atomicity guarantees and
    /// automatically replays uncommitted operations from previous crash.
    pub fn with_temporal_indexes(mut self, path: impl Into<PathBuf>) -> Result<Self> {
        let path_buf: PathBuf = path.into();

        // Initialize temporal indexes
        let indexes = TemporalIndexes::new(&path_buf)?;
        self.temporal_indexes = Some(Arc::new(indexes));

        // Initialize WAL for crash recovery
        let wal = WriteAheadLog::new(&path_buf)?;
        self.wal = Some(Arc::new(wal));

        info!("Temporal indexing and WAL enabled");

        // Replay uncommitted WAL operations from previous crash
        let replayed = self.replay_wal()
            .context("Failed to replay WAL on startup")?;

        if replayed > 0 {
            warn!("Crash recovery: replayed {} uncommitted operations", replayed);
        }

        Ok(self)
    }

    /// Get reference to temporal indexes (if enabled)
    pub fn temporal_indexes(&self) -> Option<Arc<TemporalIndexes>> {
        self.temporal_indexes.clone()
    }

    /// Health check for temporal indexes (if enabled)
    pub fn temporal_index_health(&self) -> Option<crate::bitemporal::TemporalIndexHealth> {
        self.temporal_indexes.as_ref().and_then(|indexes| {
            indexes.health_check().ok()
        })
    }

    /// Replay uncommitted WAL operations on startup (crash recovery)
    ///
    /// Scans the WAL for uncommitted operations and replays them to restore consistency.
    /// This is called automatically when temporal indexes are enabled.
    ///
    /// Returns the number of operations replayed.
    pub fn replay_wal(&self) -> Result<usize> {
        let Some(ref wal) = self.wal else {
            debug!("No WAL configured, skipping replay");
            return Ok(0);
        };

        let uncommitted = wal.get_uncommitted_operations()
            .context("Failed to get uncommitted WAL operations")?;

        if uncommitted.is_empty() {
            info!("No uncommitted WAL operations to replay");
            return Ok(0);
        }

        warn!("Replaying {} uncommitted WAL operations from previous crash", uncommitted.len());

        for entry in &uncommitted {
            match &entry.operation {
                WalOperation::InsertTriple { triple_json, version_id, tx_id_json, graph_uri } => {
                    // Deserialize the triple
                    let triple: AnnotatedTriple = serde_json::from_str(triple_json)
                        .context("Failed to deserialize triple from WAL")?;

                    let graph = graph_uri.as_ref().map(|uri| NamedGraph::new(uri));

                    // Replay the RDF store write (without logging to WAL again)
                    let subject_node = NamedNode::new(&triple.subject)?;
                    let predicate_node = NamedNode::new(&triple.predicate)?;
                    let object_term = self.parse_term(&triple.object)?;

                    let base_triple = Triple::new(
                        subject_node.clone(),
                        predicate_node.clone(),
                        object_term.clone(),
                    );

                    let base_quad = Quad::new(
                        Subject::NamedNode(subject_node),
                        predicate_node,
                        object_term,
                        Self::graph_name(graph.as_ref()),
                    );
                    self.store.insert(&base_quad)?;

                    // Replay annotations
                    for annotation in &triple.annotations {
                        let ann_predicate = NamedNode::new(&annotation.predicate)?;
                        let ann_object = self.parse_triple_value(&annotation.object)?;
                        let quoted_subject = Subject::Triple(Box::new(base_triple.clone()));

                        let annotation_quad = Quad::new(
                            quoted_subject,
                            ann_predicate,
                            ann_object,
                            Self::graph_name(graph.as_ref()),
                        );

                        self.store.insert(&annotation_quad)?;
                    }

                    // Replay temporal index update (if bitemporal)
                    if let Some(ref indexes) = self.temporal_indexes {
                        if tx_id_json != "null" {
                            let tx_id: TransactionId = serde_json::from_str(tx_id_json)
                                .context("Failed to deserialize tx_id from WAL")?;

                            indexes.index_version(&triple, version_id, &tx_id)
                                .context("Failed to replay index operation")?;
                        }
                    }

                    info!("Replayed WAL operation: {}", entry.op_id);
                },

                WalOperation::InsertBatch { triples_json, graph_uri } => {
                    // Deserialize batch
                    let triples: Vec<AnnotatedTriple> = serde_json::from_str(triples_json)
                        .context("Failed to deserialize batch from WAL")?;

                    let graph = graph_uri.as_ref().map(|uri| NamedGraph::new(uri));

                    // Replay each triple in the batch
                    for triple in &triples {
                        // Use the same replay logic as single insert
                        // (simplified version - could extract to helper method)
                        let subject_node = NamedNode::new(&triple.subject)?;
                        let predicate_node = NamedNode::new(&triple.predicate)?;
                        let object_term = self.parse_term(&triple.object)?;

                        let base_quad = Quad::new(
                            Subject::NamedNode(subject_node),
                            predicate_node,
                            object_term,
                            Self::graph_name(graph.as_ref()),
                        );
                        self.store.insert(&base_quad)?;
                    }

                    info!("Replayed batch WAL operation: {} triples", triples.len());
                },
            }

            // Commit the replayed operation
            wal.commit(&entry.op_id)
                .context("Failed to commit replayed WAL entry")?;
        }

        info!("Successfully replayed {} WAL operations", uncommitted.len());
        Ok(uncommitted.len())
    }

    /// Get WAL statistics for monitoring
    ///
    /// Returns statistics about the WAL including total entries and uncommitted count.
    /// Used by the /admin/wal/status API endpoint for dashboard monitoring.
    pub fn wal_statistics(&self) -> Result<crate::governance::WalStatistics> {
        let Some(ref wal) = self.wal else {
            // No WAL configured - return zero stats
            return Ok(crate::governance::WalStatistics {
                total_entries: 0,
                uncommitted_entries: 0,
            });
        };

        wal.statistics()
            .context("Failed to get WAL statistics")
    }

    /// Get list of uncommitted WAL operations
    ///
    /// Returns all WAL entries that haven't been committed yet.
    /// Used by the /admin/wal/operations API endpoint for inspection.
    pub fn get_uncommitted_wal_operations(&self) -> Result<Vec<crate::governance::WalEntry>> {
        let Some(ref wal) = self.wal else {
            // No WAL configured - return empty list
            return Ok(Vec::new());
        };

        wal.get_uncommitted_operations()
            .context("Failed to get uncommitted WAL operations")
    }

    /// Save RDF store to disk (hybrid persistence)
    ///
    /// Dumps all RDF triples to the backup file in N-Quads format.
    /// This should be called periodically or before shutdown to persist changes.
    ///
    /// **Performance**:
    /// - Uses atomic write (temp file + rename) for crash safety
    /// - N-Quads format for fast serialization (~1ms per 1000 triples)
    /// - Compresses well with filesystem-level compression (zstd, etc.)
    ///
    /// Returns the number of quads written.
    pub fn save_to_disk(&self) -> Result<usize> {
        let Some(ref backup_path) = self.backup_path else {
            debug!("No backup path configured, skipping save");
            return Ok(0);
        };

        info!("Saving RDF store to disk: {}", backup_path.display());
        let start = std::time::Instant::now();

        // Create atomic write using temp file + rename
        let temp_path = backup_path.with_extension("nq.tmp");

        // Dump store to temporary file
        let mut buffer = Vec::new();
        use oxigraph::io::{RdfFormat, RdfSerializer};
        self.store.dump_to_writer(
            RdfSerializer::from_format(RdfFormat::NQuads),
            &mut buffer
        ).context("Failed to dump RDF store")?;

        // Write to temp file
        std::fs::write(&temp_path, &buffer)
            .context("Failed to write RDF backup to temp file")?;

        // Atomic rename (crash-safe)
        std::fs::rename(&temp_path, backup_path)
            .context("Failed to rename backup file")?;

        let quad_count = buffer.split(|&b| b == b'\n').filter(|l| !l.is_empty()).count();
        let duration_ms = start.elapsed().as_millis();

        // Update last save time
        let now = std::time::SystemTime::now()
            .duration_since(std::time::UNIX_EPOCH)
            .unwrap_or_default()
            .as_secs();
        self.last_save_time.store(now, Ordering::Relaxed);

        info!("✅ RDF store saved: {} quads in {}ms", quad_count, duration_ms);
        Ok(quad_count)
    }

    /// Start background auto-save task
    ///
    /// Spawns a Tokio task that periodically saves the RDF store to disk.
    /// This eliminates the need for manual `save_to_disk()` calls and provides
    /// automatic crash recovery with bounded data loss.
    ///
    /// **Parameters**:
    /// - `interval_secs`: Time between auto-saves (recommended: 300 = 5 minutes)
    ///
    /// **Data Loss Window**: Max `interval_secs` of unsaved data if process crashes
    ///
    /// **Graceful Shutdown**: Call `stop_auto_save()` to trigger final save before exit
    ///
    /// **Example**:
    /// ```rust
    /// // Auto-save every 5 minutes
    /// rdf_store.start_auto_save(300);
    ///
    /// // On shutdown
    /// rdf_store.stop_auto_save().await?;
    /// ```
    pub fn start_auto_save(&self, interval_secs: u64) -> tokio::task::JoinHandle<()> {
        let store = self.clone();
        let interval = Duration::from_secs(interval_secs);

        info!("🕐 Starting background auto-save task (interval: {}s)", interval_secs);

        tokio::spawn(async move {
            let mut ticker = tokio::time::interval(interval);
            ticker.set_missed_tick_behavior(tokio::time::MissedTickBehavior::Skip);

            loop {
                tokio::select! {
                    _ = ticker.tick() => {
                        // Periodic save
                        match store.save_to_disk() {
                            Ok(count) => {
                                store.auto_save_count.fetch_add(1, Ordering::Relaxed);
                                info!("💾 Auto-save completed: {} quads persisted", count);
                            }
                            Err(e) => {
                                store.auto_save_failures.fetch_add(1, Ordering::Relaxed);
                                error!("❌ Auto-save failed: {}", e);
                            }
                        }
                    }

                    _ = store.shutdown_notify.notified() => {
                        // Graceful shutdown - perform final save
                        info!("🛑 Auto-save task received shutdown signal");

                        match store.save_to_disk() {
                            Ok(count) => {
                                info!("💾 Final save completed: {} quads persisted", count);
                            }
                            Err(e) => {
                                error!("❌ Final save failed: {}", e);
                            }
                        }

                        info!("✅ Auto-save task stopped gracefully");
                        break;
                    }
                }

                // Check if shutdown flag is set
                if store.shutdown.load(Ordering::Relaxed) {
                    break;
                }
            }
        })
    }

    /// Stop auto-save task and perform final save
    ///
    /// Signals the auto-save background task to stop and waits for the final save.
    /// Should be called during application shutdown to ensure all data is persisted.
    ///
    /// **Blocks** until the auto-save task completes the final save.
    ///
    /// **Example**:
    /// ```rust
    /// // On SIGTERM or application shutdown
    /// rdf_store.stop_auto_save().await?;
    /// ```
    pub async fn stop_auto_save(&self) -> Result<()> {
        info!("Stopping auto-save task...");

        // Set shutdown flag
        self.shutdown.store(true, Ordering::Relaxed);

        // Notify the auto-save task
        self.shutdown_notify.notify_one();

        // Give the task time to complete final save (max 30 seconds)
        tokio::time::sleep(Duration::from_secs(1)).await;

        info!("Auto-save task stopped");
        Ok(())
    }

    /// Get auto-save statistics
    ///
    /// Returns metrics about the auto-save task for monitoring and alerting.
    ///
    /// **Metrics**:
    /// - `last_save_time`: Unix timestamp of last successful save (0 if never saved)
    /// - `auto_save_count`: Total number of successful auto-saves
    /// - `auto_save_failures`: Total number of failed auto-saves
    /// - `seconds_since_last_save`: Time since last save (None if never saved)
    pub fn get_auto_save_stats(&self) -> AutoSaveStats {
        let last_save = self.last_save_time.load(Ordering::Relaxed);
        let now = std::time::SystemTime::now()
            .duration_since(std::time::UNIX_EPOCH)
            .unwrap_or_default()
            .as_secs();

        let seconds_since_last_save = if last_save > 0 {
            Some(now.saturating_sub(last_save))
        } else {
            None
        };

        AutoSaveStats {
            last_save_time: last_save,
            auto_save_count: self.auto_save_count.load(Ordering::Relaxed),
            auto_save_failures: self.auto_save_failures.load(Ordering::Relaxed),
            seconds_since_last_save,
        }
    }

    /// Check if a triple has bitemporal annotations
    fn is_bitemporal_triple(triple: &AnnotatedTriple) -> bool {
        let has_tx_id = triple.annotations.iter()
            .any(|a| a.predicate == "http://graphica.io/ontology#txId");
        let has_valid_from = triple.annotations.iter()
            .any(|a| a.predicate == "http://graphica.io/ontology#validFrom");

        has_tx_id && has_valid_from
    }

    /// Extract TransactionId from triple annotations
    fn extract_transaction_id(triple: &AnnotatedTriple) -> Result<TransactionId> {
        let mut tx_seq: Option<u64> = None;
        let mut tx_from: Option<chrono::DateTime<chrono::Utc>> = None;
        let mut node_id: Option<u16> = None;

        for ann in &triple.annotations {
            match ann.predicate.as_str() {
                "http://graphica.io/ontology#txId" => {
                    if let TripleValue::TypedLiteral { value, .. } = &ann.object {
                        tx_seq = Some(value.parse()?);
                    } else if let TripleValue::Literal(val) = &ann.object {
                        tx_seq = Some(val.parse()?);
                    }
                }
                "http://graphica.io/ontology#txFrom" => {
                    if let TripleValue::TypedLiteral { value, .. } = &ann.object {
                        let parsed = chrono::DateTime::parse_from_rfc3339(value)?;
                        tx_from = Some(parsed.with_timezone(&chrono::Utc));
                    }
                }
                "http://graphica.io/ontology#nodeId" => {
                    if let TripleValue::TypedLiteral { value, .. } = &ann.object {
                        node_id = Some(value.parse()?);
                    } else if let TripleValue::Literal(val) = &ann.object {
                        node_id = Some(val.parse()?);
                    }
                }
                _ => {}
            }
        }

        let seq = tx_seq.context("Missing txId annotation")?;
        let timestamp = tx_from.context("Missing txFrom annotation")?;
        let nid = node_id.context("Missing nodeId annotation")?;

        Ok(TransactionId::new(seq, timestamp, nid))
    }

    /// Get underlying Oxigraph store
    pub fn inner(&self) -> &Store {
        &self.store
    }

    /// Convert graph option to GraphName
    fn graph_name(graph: Option<&NamedGraph>) -> GraphName {
        match graph {
            Some(g) => {
                GraphName::NamedNode(
                    NamedNode::new(&g.uri).expect("Invalid graph URI")
                )
            }
            None => GraphName::DefaultGraph,
        }
    }

    /// Parse SPARQL query results to JSON
    fn query_results_to_json(results: QueryResults) -> Result<Vec<JsonValue>> {
        match results {
            QueryResults::Solutions(solutions) => {
                let mut json_results = Vec::new();

                for solution in solutions {
                    let solution = solution?;
                    let mut row = serde_json::Map::new();

                    for (var, term) in solution.iter() {
                        let value = match term {
                            Term::NamedNode(n) => JsonValue::String(n.as_str().to_string()),
                            Term::Literal(l) => {
                                // Try to parse as number, otherwise string
                                if let Ok(num) = l.value().parse::<f64>() {
                                    JsonValue::Number(serde_json::Number::from_f64(num).unwrap_or_else(|| {
                                        serde_json::Number::from(0)
                                    }))
                                } else {
                                    JsonValue::String(l.value().to_string())
                                }
                            }
                            Term::BlankNode(b) => JsonValue::String(format!("_:{}", b.as_str())),
                            _ => JsonValue::Null,
                        };

                        row.insert(var.as_str().to_string(), value);
                    }

                    json_results.push(JsonValue::Object(row));
                }

                Ok(json_results)
            }
            QueryResults::Boolean(b) => {
                Ok(vec![JsonValue::Bool(b)])
            }
            QueryResults::Graph(_) => {
                // For CONSTRUCT/DESCRIBE queries, return empty for now
                // TODO: Serialize graph results
                warn!("Graph query results not yet serialized to JSON");
                Ok(vec![])
            }
        }
    }
}

impl RdfStore for GraphicaRdfStore {
    fn insert_triple(&self, subject: &str, predicate: &str, object: &str, graph: Option<&NamedGraph>) -> Result<()> {
        let subject_node = NamedNode::new(subject)
            .context(format!("Invalid subject URI: {}", subject))?;

        let predicate_node = NamedNode::new(predicate)
            .context(format!("Invalid predicate URI: {}", predicate))?;

        // Object can be a URI or a literal
        let object_term: Term = if object.starts_with("http://") || object.starts_with("https://") {
            Term::NamedNode(
                NamedNode::new(object)
                    .context(format!("Invalid object URI: {}", object))?
            )
        } else {
            // Treat as literal
            Term::Literal(oxigraph::model::Literal::new_simple_literal(object))
        };

        let quad = Quad::new(
            Subject::NamedNode(subject_node),
            predicate_node,
            object_term,
            Self::graph_name(graph),
        );

        self.store.insert(&quad)?;

        debug!("Inserted triple: {} {} {} (graph: {:?})",
               subject, predicate, object, graph.map(|g| &g.uri));

        Ok(())
    }

    fn insert_triples(&self, triples: Vec<(String, String, String)>, graph: Option<&NamedGraph>) -> Result<()> {
        let graph_name = Self::graph_name(graph);
        let count = triples.len();

        // CRITICAL FIX: Process in chunks to prevent memory spikes
        // - Large batches (25K triples) could allocate 50MB+ at once
        // - Chunking limits memory to ~1MB per chunk while maintaining bulk insert performance
        const CHUNK_SIZE: usize = 1000;

        for chunk in triples.chunks(CHUNK_SIZE) {
            // Build quads for this chunk only
            let quads: Result<Vec<Quad>> = chunk.iter()
                .map(|(subject, predicate, object)| {
                    let subject_node = NamedNode::new(subject)
                        .context(format!("Invalid subject URI: {}", subject))?;

                    let predicate_node = NamedNode::new(predicate)
                        .context(format!("Invalid predicate URI: {}", predicate))?;

                    let object_term: Term = if object.starts_with("http://") || object.starts_with("https://") {
                        Term::NamedNode(
                            NamedNode::new(object)
                                .context(format!("Invalid object URI: {}", object))?
                        )
                    } else {
                        Term::Literal(oxigraph::model::Literal::new_simple_literal(object))
                    };

                    Ok(Quad::new(
                        Subject::NamedNode(subject_node),
                        predicate_node,
                        object_term,
                        graph_name.clone(),
                    ))
                })
                .collect();

            let quads = quads?;

            // Bulk insert this chunk using extend (much faster than individual inserts)
            self.store.extend(quads)?;
        }

        debug!("Bulk inserted {} triples in chunks of {} (graph: {:?})",
              count, CHUNK_SIZE, graph.map(|g| &g.uri));

        Ok(())
    }

    fn query(&self, sparql: &str) -> Result<Vec<JsonValue>> {
        debug!("Executing SPARQL query: {}", sparql);

        let query = Query::parse(sparql, None)
            .context("Failed to parse SPARQL query")?;

        let results = self.store.query(query)?;

        Self::query_results_to_json(results)
    }

    fn update(&self, sparql_update: &str) -> Result<()> {
        debug!("Executing SPARQL UPDATE: {}", sparql_update);

        self.store.update(sparql_update)
            .context("Failed to execute SPARQL UPDATE")?;

        info!("SPARQL UPDATE executed successfully");
        Ok(())
    }

    fn load_turtle(&self, turtle: &str, graph: Option<&NamedGraph>) -> Result<()> {
        use oxigraph::io::RdfFormat;
        use std::io::Cursor;

        let reader = Cursor::new(turtle.as_bytes());
        let graph_name = Self::graph_name(graph);

        // Load triples from turtle into the specified graph
        // Using deprecated method until Oxigraph provides clear migration path
        #[allow(deprecated)]
        self.store.load_graph(
            reader,
            RdfFormat::Turtle,
            graph_name,
            None, // No base IRI
        )?;

        let count = self.count_triples(graph)?;

        info!("Loaded {} triples from Turtle (graph: {:?})",
              count, graph.map(|g| &g.uri));

        Ok(())
    }

    fn load_ontology(&self, turtle: &str) -> Result<()> {
        self.load_turtle(turtle, None)?;
        info!("Ontology loaded ({} bytes)", turtle.len());
        Ok(())
    }

    fn count_triples(&self, graph: Option<&NamedGraph>) -> Result<u64> {
        let graph_name_ref = match graph {
            Some(g) => Some(NamedNode::new(&g.uri).context("Invalid graph URI")?),
            None => None,
        };

        // Count quads in the graph
        let count = match graph_name_ref {
            Some(ref g) => {
                self.store.quads_for_pattern(None, None, None, Some(g.into()))
                    .count() as u64
            }
            None => {
                self.store.quads_for_pattern(None, None, None, None)
                    .count() as u64
            }
        };

        debug!("Triple count in graph {:?}: {}", graph.map(|g| &g.uri), count);

        Ok(count)
    }

    fn clear_graph(&self, graph: &NamedGraph) -> Result<()> {
        let graph_node = NamedNode::new(&graph.uri)
            .context(format!("Invalid graph URI: {}", graph.uri))?;

        self.store.clear_graph(&GraphName::NamedNode(graph_node))?;

        info!("Cleared graph: {}", graph.uri);

        Ok(())
    }
}

impl GraphicaRdfStore {
    /// Get the total number of triples in the store (for monitoring)
    pub fn triple_count(&self) -> Result<usize> {
        let count_query = "SELECT (COUNT(*) as ?count) WHERE { ?s ?p ?o }";
        let results = self.query(count_query)?;

        if let Some(first) = results.first() {
            if let Some(count_val) = first.get("count") {
                match count_val {
                    JsonValue::Number(n) => {
                        if let Some(count) = n.as_u64() {
                            return Ok(count as usize);
                        }
                    }
                    JsonValue::String(s) => {
                        // Handle cases like "123"^^xsd:integer
                        let count_str = s.split('^').next().unwrap_or(s);
                        let count_str = count_str.trim_matches('"');
                        if let Ok(count) = count_str.parse::<usize>() {
                            return Ok(count);
                        }
                    }
                    _ => {}
                }
            }
        }

        Ok(0)
    }

    // RDF-star Support Methods

    /// Insert an RDF-star annotated triple with atomic consistency and crash recovery
    ///
    /// Creates a quoted triple and attaches annotations to it.
    /// In RDF-star: << subject predicate object >> annotation_pred annotation_obj
    ///
    /// **Atomicity Guarantee**: Write-Ahead Log (WAL) ensures crash recovery.
    /// If process crashes mid-operation, the WAL is replayed on startup to restore consistency.
    ///
    /// **Write Path**:
    /// 1. Log operation to WAL (uncommitted)
    /// 2. Execute RDF store write
    /// 3. Execute temporal index update
    /// 4. Commit WAL entry (atomic delete)
    pub fn insert_rdf_star_triple(
        &self,
        triple: &AnnotatedTriple,
        graph: Option<&NamedGraph>,
    ) -> Result<()> {
        // Acquire write lock for atomicity across RDF store + indexes
        let _write_guard = self.write_lock.write();

        // Extract version_id and tx_id early (needed for both WAL and indexing)
        let version_id = Uuid::new_v4().to_string();
        let tx_id_opt = if Self::is_bitemporal_triple(triple) {
            Some(Self::extract_transaction_id(triple)?)
        } else {
            None
        };

        // STEP 1: Log operation to WAL (if enabled)
        let wal_op_id = if let Some(ref wal) = self.wal {
            let operation = WalOperation::InsertTriple {
                triple_json: serde_json::to_string(triple)
                    .context("Failed to serialize triple for WAL")?,
                version_id: version_id.clone(),
                tx_id_json: if let Some(ref tx_id) = tx_id_opt {
                    serde_json::to_string(tx_id)
                        .context("Failed to serialize tx_id for WAL")?
                } else {
                    "null".to_string()
                },
                graph_uri: graph.map(|g| g.uri.clone()),
            };

            Some(wal.log_operation(operation)
                .context("Failed to log operation to WAL")?)
        } else {
            None
        };

        // STEP 2: Execute RDF store write
        let subject_node = NamedNode::new(&triple.subject)
            .context(format!("Invalid subject URI: {}", triple.subject))?;

        let predicate_node = NamedNode::new(&triple.predicate)
            .context(format!("Invalid predicate URI: {}", triple.predicate))?;

        let object_term = self.parse_term(&triple.object)?;

        // Create the triple (for RDF-star quoted triple subject)
        let base_triple = Triple::new(
            subject_node.clone(),
            predicate_node.clone(),
            object_term.clone(),
        );

        // Insert the base triple as a regular statement
        let base_quad = Quad::new(
            Subject::NamedNode(subject_node),
            predicate_node,
            object_term,
            Self::graph_name(graph),
        );
        self.store.insert(&base_quad)?;

        // RDF-star Support: Use quoted triples as subjects for annotations
        for annotation in &triple.annotations {
            let ann_predicate = NamedNode::new(&annotation.predicate)
                .context(format!("Invalid annotation predicate: {}", annotation.predicate))?;

            let ann_object = self.parse_triple_value(&annotation.object)?;

            // Create RDF-star quoted triple as subject
            let quoted_subject = Subject::Triple(Box::new(base_triple.clone()));

            let annotation_quad = Quad::new(
                quoted_subject,
                ann_predicate,
                ann_object,
                Self::graph_name(graph),
            );

            self.store.insert(&annotation_quad)?;
        }

        debug!("Inserted RDF-star triple with {} annotations", triple.annotations.len());

        // STEP 3: Execute temporal index update (if bitemporal)
        if let Some(ref indexes) = self.temporal_indexes {
            if let Some(ref tx_id) = tx_id_opt {
                indexes.index_version(triple, &version_id, tx_id)
                    .context("Failed to index bitemporal triple")?;

                debug!("Auto-indexed bitemporal triple with version_id: {}", version_id);
            }
        }

        // STEP 4: Commit WAL entry (operation succeeded, atomically delete WAL file)
        if let (Some(ref wal), Some(op_id)) = (&self.wal, wal_op_id) {
            wal.commit(&op_id)
                .context("Failed to commit WAL entry")?;
        }

        // Write lock released here (via _write_guard drop)
        Ok(())
    }

    /// Batch insert RDF-star annotated triples
    pub fn insert_rdf_star_batch(
        &self,
        triples: &[AnnotatedTriple],
        graph: Option<&NamedGraph>,
    ) -> Result<()> {
        for triple in triples {
            self.insert_rdf_star_triple(triple, graph)?;
        }

        info!("Inserted {} RDF-star triples", triples.len());
        Ok(())
    }

    /// Query with RDF-star SPARQL
    ///
    /// Oxigraph should handle RDF-star SPARQL natively if supported
    pub fn query_rdf_star(&self, sparql: &str) -> Result<Vec<JsonValue>> {
        // For now, use regular query - Oxigraph may handle RDF-star syntax
        self.query(sparql)
    }

    /// Parse a term string to an Oxigraph Term
    fn parse_term(&self, value: &str) -> Result<Term> {
        if value.starts_with("http://") || value.starts_with("https://") {
            Ok(Term::NamedNode(NamedNode::new(value)?))
        } else {
            Ok(Term::Literal(Literal::new_simple_literal(value)))
        }
    }

    /// Parse a TripleValue to an Oxigraph Term
    fn parse_triple_value(&self, value: &TripleValue) -> Result<Term> {
        match value {
            TripleValue::Uri(uri) => {
                Ok(Term::NamedNode(NamedNode::new(uri)?))
            }
            TripleValue::Literal(lit) => {
                Ok(Term::Literal(Literal::new_simple_literal(lit)))
            }
            TripleValue::TypedLiteral { value, datatype } => {
                let dt_node = NamedNode::new(
                    if datatype.starts_with("xsd:") {
                        format!("http://www.w3.org/2001/XMLSchema#{}", &datatype[4..])
                    } else {
                        datatype.clone()
                    }
                )?;
                Ok(Term::Literal(Literal::new_typed_literal(value, dt_node)))
            }
            TripleValue::LanguageLiteral { value, lang } => {
                Ok(Term::Literal(Literal::new_language_tagged_literal(value, lang)?))
            }
        }
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn test_in_memory_store() {
        let store = GraphicaRdfStore::new_in_memory().unwrap();

        // Insert a triple
        store.insert_triple(
            "http://example.org/subject",
            "http://example.org/predicate",
            "object_value",
            None
        ).unwrap();

        // Count triples
        let count = store.count_triples(None).unwrap();
        assert_eq!(count, 1);
    }

    #[test]
    fn test_named_graphs() {
        let store = GraphicaRdfStore::new_in_memory().unwrap();

        let graph = NamedGraph::current();

        store.insert_triple(
            "http://graphica.io/entity/123",
            "http://www.w3.org/1999/02/22-rdf-syntax-ns#type",
            "http://graphica.io/ontology#Entity",
            Some(&graph)
        ).unwrap();

        let count = store.count_triples(Some(&graph)).unwrap();
        assert_eq!(count, 1);
    }

    #[test]
    fn test_sparql_query() {
        let store = GraphicaRdfStore::new_in_memory().unwrap();

        // Insert test data
        store.insert_triple(
            "http://graphica.io/entity/123",
            "http://graphica.io/ontology#entityId",
            "customer_123",
            None
        ).unwrap();

        // Query
        let query = r#"
            PREFIX gph: <http://graphica.io/ontology#>
            SELECT ?id WHERE {
                ?entity gph:entityId ?id .
            }
        "#;

        let results = store.query(query).unwrap();
        assert_eq!(results.len(), 1);
    }

    #[test]
    fn test_batch_insert() {
        let store = GraphicaRdfStore::new_in_memory().unwrap();

        let triples = vec![
            (
                "http://graphica.io/entity/1".to_string(),
                "http://graphica.io/ontology#entityId".to_string(),
                "entity_1".to_string(),
            ),
            (
                "http://graphica.io/entity/2".to_string(),
                "http://graphica.io/ontology#entityId".to_string(),
                "entity_2".to_string(),
            ),
        ];

        store.insert_triples(triples, None).unwrap();

        let count = store.count_triples(None).unwrap();
        assert_eq!(count, 2);
    }
}

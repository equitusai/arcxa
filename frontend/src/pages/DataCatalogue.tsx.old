/**
 * Data Catalogue Page
 * Browse and manage datasets from all connected datasources
 */

import React, { useState } from 'react';
import { useNavigate } from 'react-router-dom';
import { motion } from 'framer-motion';
import { Card, CardContent } from '@/components/ui/card';
import { Button } from '@/components/ui/button';
import { Input } from '@/components/ui/input';
import {
  Select,
  SelectContent,
  SelectItem,
  SelectTrigger,
  SelectValue,
} from '@/components/ui/select';
import { Alert, AlertDescription } from '@/components/ui/alert';
import { Skeleton } from '@/components/ui/skeleton';
import { Search, Filter, RefreshCw, Database, Plus } from 'lucide-react';
import { useDatasets } from '@/hooks/useDatasets';
import { DatasetCard } from '@/components/catalogue/DatasetCard';
import { Breadcrumbs } from '@/components/Breadcrumbs';

export function DataCatalogue() {
  const navigate = useNavigate();
  const [searchQuery, setSearchQuery] = useState('');
  const [sourceFilter, setSourceFilter] = useState<string>('all');
  const [qualityFilter, setQualityFilter] = useState<string>('all');
  const [statusFilter, setStatusFilter] = useState<string>('all');

  // Build filters object for API
  const filters = {
    source: sourceFilter !== 'all' ? sourceFilter : undefined,
    minQuality: qualityFilter !== 'all' ? parseInt(qualityFilter) : undefined,
    status: statusFilter !== 'all' ? statusFilter : undefined,
  };

  // Fetch datasets with filters
  const { data, isLoading, error, refetch } = useDatasets(filters);

  // Client-side search filtering
  const filteredDatasets = React.useMemo(() => {
    if (!data?.datasets) return [];

    if (!searchQuery) return data.datasets;

    const query = searchQuery.toLowerCase();
    return data.datasets.filter(
      (dataset) =>
        dataset.name.toLowerCase().includes(query) ||
        dataset.description?.toLowerCase().includes(query) ||
        dataset.id.toLowerCase().includes(query) ||
        dataset.source_name?.toLowerCase().includes(query)
    );
  }, [data?.datasets, searchQuery]);

  // Get unique sources for filter dropdown
  const uniqueSources = React.useMemo(() => {
    if (!data?.datasets) return [];
    const sources = new Set<string>();
    data.datasets.forEach((dataset) => {
      if (dataset.source_name) sources.add(dataset.source_name);
    });
    return Array.from(sources).sort();
  }, [data?.datasets]);

  const hasData = data && data.datasets.length > 0;

  return (
    <div className="space-y-4">
      {/* Breadcrumbs */}
      <Breadcrumbs
        items={[
          { label: 'Data Management', href: '/catalogue' },
          { label: 'Data Catalogue' },
        ]}
      />

      {/* Page Header */}
      <motion.div
        initial={{ opacity: 0, y: -8 }}
        animate={{ opacity: 1, y: 0 }}
        transition={{ duration: 0.15 }}
        className="flex items-start justify-between pb-3 border-b border-border"
      >
        <div className="min-w-0 flex-1">
          <h1 className="text-xl font-bold text-foreground mb-1">Data Catalogue</h1>
          <p className="text-sm text-muted-foreground">
            Browse datasets from all connected datasources and view quality metrics
          </p>
        </div>
        <div className="flex gap-2 ml-4">
          <Button
            variant="outline"
            size="default"
            className="gap-2"
            onClick={() => refetch()}
            title="Refresh datasets"
          >
            <RefreshCw className="h-4 w-4" />
            Refresh
          </Button>
          <Button size="default" className="gap-2" disabled title="Coming soon">
            <Plus className="h-4 w-4" />
            Import Dataset
          </Button>
        </div>
      </motion.div>

      {/* Search and Filters */}
      <motion.div
        initial={{ opacity: 0, y: 8 }}
        animate={{ opacity: 1, y: 0 }}
        transition={{ duration: 0.15, delay: 0.05 }}
      >
        <Card className="glass-morphism border-border">
          <CardContent className="p-3">
            <div className="flex gap-2 flex-wrap">
              <div className="relative flex-1 min-w-[200px]">
                <Search className="absolute left-2.5 top-1/2 h-4 w-4 -translate-y-1/2 text-muted-foreground" />
                <Input
                  placeholder="Search datasets by name, description, or ID..."
                  className="pl-9 h-8"
                  value={searchQuery}
                  onChange={(e) => setSearchQuery(e.target.value)}
                />
              </div>

              <Select value={sourceFilter} onValueChange={setSourceFilter}>
                <SelectTrigger className="w-[160px] h-8">
                  <SelectValue placeholder="All Sources" />
                </SelectTrigger>
                <SelectContent>
                  <SelectItem value="all">All Sources</SelectItem>
                  {uniqueSources.map((source) => (
                    <SelectItem key={source} value={source}>
                      {source}
                    </SelectItem>
                  ))}
                </SelectContent>
              </Select>

              <Select value={qualityFilter} onValueChange={setQualityFilter}>
                <SelectTrigger className="w-[140px] h-8">
                  <SelectValue placeholder="All Quality" />
                </SelectTrigger>
                <SelectContent>
                  <SelectItem value="all">All Quality</SelectItem>
                  <SelectItem value="80">Good (80%+)</SelectItem>
                  <SelectItem value="60">Fair (60%+)</SelectItem>
                  <SelectItem value="0">Poor (&lt;60%)</SelectItem>
                </SelectContent>
              </Select>

              <Select value={statusFilter} onValueChange={setStatusFilter}>
                <SelectTrigger className="w-[120px] h-8">
                  <SelectValue placeholder="All Status" />
                </SelectTrigger>
                <SelectContent>
                  <SelectItem value="all">All Status</SelectItem>
                  <SelectItem value="active">Active</SelectItem>
                  <SelectItem value="stale">Stale</SelectItem>
                  <SelectItem value="error">Error</SelectItem>
                </SelectContent>
              </Select>

              <Button
                variant="outline"
                className="gap-2 h-8"
                onClick={() => {
                  setSearchQuery('');
                  setSourceFilter('all');
                  setQualityFilter('all');
                  setStatusFilter('all');
                }}
                disabled={
                  !searchQuery &&
                  sourceFilter === 'all' &&
                  qualityFilter === 'all' &&
                  statusFilter === 'all'
                }
              >
                <Filter className="h-4 w-4" />
                Clear
              </Button>
            </div>
          </CardContent>
        </Card>
      </motion.div>

      {/* Error State */}
      {error && (
        <Alert variant="destructive">
          <AlertDescription>
            Failed to load datasets. Please check that the backend is running and try again.
          </AlertDescription>
        </Alert>
      )}

      {/* Dataset Grid */}
      <motion.div
        initial={{ opacity: 0, y: 8 }}
        animate={{ opacity: 1, y: 0 }}
        transition={{ duration: 0.15, delay: 0.1 }}
      >
        {isLoading ? (
          // Loading skeleton grid
          <div className="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
            {Array.from({ length: 6 }).map((_, index) => (
              <Card key={index} className="h-[280px]">
                <CardContent className="p-4 space-y-3">
                  <Skeleton className="h-5 w-3/4" />
                  <Skeleton className="h-4 w-full" />
                  <Skeleton className="h-4 w-2/3" />
                  <div className="pt-3 space-y-2">
                    <Skeleton className="h-4 w-1/2" />
                    <Skeleton className="h-4 w-2/3" />
                  </div>
                </CardContent>
              </Card>
            ))}
          </div>
        ) : !hasData ? (
          // Empty state - no datasets at all
          <Card className="glass-morphism border-border">
            <CardContent className="py-16">
              <div className="flex flex-col items-center justify-center text-center">
                <Database className="h-16 w-16 text-muted-foreground mb-4 opacity-50" />
                <h3 className="text-lg font-semibold text-foreground mb-2">
                  No datasets found
                </h3>
                <p className="text-sm text-muted-foreground max-w-md mb-6">
                  Connect datasources to start importing datasets. Datasets are automatically
                  discovered from your connected datasources.
                </p>
                <Button className="gap-2" onClick={() => navigate('/datasources')}>
                  <Plus className="h-4 w-4" />
                  Connect Datasource
                </Button>
              </div>
            </CardContent>
          </Card>
        ) : filteredDatasets.length === 0 ? (
          // Empty state - no results for current filters
          <Card className="glass-morphism border-border">
            <CardContent className="py-12">
              <div className="flex flex-col items-center justify-center text-center">
                <Search className="h-12 w-12 text-muted-foreground mb-3 opacity-50" />
                <h3 className="text-base font-semibold text-foreground mb-1">
                  No matching datasets
                </h3>
                <p className="text-sm text-muted-foreground">
                  Try adjusting your search or filter criteria
                </p>
              </div>
            </CardContent>
          </Card>
        ) : (
          // Dataset grid
          <div>
            <div className="flex items-center justify-between mb-3">
              <p className="text-sm text-muted-foreground">
                Showing{' '}
                <span className="font-semibold text-foreground">
                  {filteredDatasets.length}
                </span>{' '}
                {filteredDatasets.length === 1 ? 'dataset' : 'datasets'}
              </p>
            </div>
            <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
              {filteredDatasets.map((dataset) => (
                <DatasetCard
                  key={dataset.id}
                  dataset={dataset}
                />
              ))}
            </div>
          </div>
        )}
      </motion.div>
    </div>
  );
}

@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix ecom: <http://equitus.ai/ontology/ecommerce#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://equitus.ai/ontology/ecommerce> a owl:Ontology ;
    dc:creator "Equitus.ai" ;
    dc:description "Comprehensive ecommerce ontology covering products, customers, orders, addresses, and demographics" ;
    dc:title "Equitus.ai Ecommerce Ontology" ;
    owl:versionInfo "1.1" .

ecom:BankTransfer a owl:Class ;
    rdfs:label "Bank Transfer" ;
    rdfs:subClassOf ecom:PaymentMethod .

ecom:Cancelled a ecom:OrderStatus ;
    rdfs:label "Cancelled" .

ecom:CreditCard a owl:Class ;
    rdfs:label "Credit Card" ;
    rdfs:subClassOf ecom:PaymentMethod .

ecom:Delivered a ecom:OrderStatus ;
    rdfs:label "Delivered" .

ecom:DigitalProduct a owl:Class ;
    rdfs:label "Digital Product" ;
    rdfs:comment "A digital product delivered electronically" ;
    rdfs:subClassOf ecom:Product .

ecom:PayPal a owl:Class ;
    rdfs:label "PayPal" ;
    rdfs:subClassOf ecom:PaymentMethod .

ecom:Pending a ecom:OrderStatus ;
    rdfs:label "Pending" .

ecom:Processing a ecom:OrderStatus ;
    rdfs:label "Processing" .

ecom:Returned a ecom:OrderStatus ;
    rdfs:label "Returned" .

ecom:RootCategory a owl:Class ;
    rdfs:label "Root Category" ;
    rdfs:comment "Top-level category with no parent" ;
    rdfs:subClassOf ecom:Category .

ecom:Service a owl:Class ;
    rdfs:label "Service" ;
    rdfs:comment "A service offering rather than a physical or digital good" ;
    rdfs:subClassOf ecom:Product .

ecom:Shipped a ecom:OrderStatus ;
    rdfs:label "Shipped" .


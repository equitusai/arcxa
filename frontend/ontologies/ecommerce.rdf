<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:dc="http://purl.org/dc/elements/1.1/"
         xmlns:ecom="http://equitus.ai/ontology/ecommerce#">

  <!-- Ontology Metadata -->
  <owl:Ontology rdf:about="http://equitus.ai/ontology/ecommerce">
    <dc:title>Equitus.ai Ecommerce Ontology</dc:title>
    <dc:description>Comprehensive ecommerce ontology covering products, customers, orders, addresses, and demographics</dc:description>
    <dc:creator>Equitus.ai</dc:creator>
    <owl:versionInfo>1.1</owl:versionInfo>
  </owl:Ontology>

  <!-- =============================================== -->
  <!-- CORE CLASSES - Customer Domain -->
  <!-- =============================================== -->
  
  <owl:Class rdf:about="http://equitus.ai/ontology/ecommerce#Customer">
    <rdfs:label>Customer</rdfs:label>
    <rdfs:comment>A person or organization that purchases products or services</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://equitus.ai/ontology/ecommerce#IndividualCustomer">
    <rdfs:label>Individual Customer</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://equitus.ai/ontology/ecommerce#Customer"/>
    <rdfs:comment>A customer who is an individual person</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://equitus.ai/ontology/ecommerce#BusinessCustomer">
    <rdfs:label>Business Customer</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://equitus.ai/ontology/ecommerce#Customer"/>
    <rdfs:comment>A customer who represents a business or organization</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://equitus.ai/ontology/ecommerce#CustomerAccount">
    <rdfs:label>Customer Account</rdfs:label>
    <rdfs:comment>The account information and credentials for a customer</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://equitus.ai/ontology/ecommerce#CustomerSegment">
    <rdfs:label>Customer Segment</rdfs:label>
    <rdfs:comment>A categorization of customers based on characteristics or behavior</rdfs:comment>
  </owl:Class>

  <!-- =============================================== -->
  <!-- DEMOGRAPHIC CLASSES -->
  <!-- =============================================== -->

  <owl:Class rdf:about="http://equitus.ai/ontology/ecommerce#Demographics">
    <rdfs:label>Demographics</rdfs:label>
    <rdfs:comment>Demographic information about a customer</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://equitus.ai/ontology/ecommerce#AgeGroup">
    <rdfs:label>Age Group</rdfs:label>
    <rdfs:comment>Age range classification for demographic analysis</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://equitus.ai/ontology/ecommerce#Gender">
    <rdfs:label>Gender</rdfs:label>
    <rdfs:comment>Gender classification for demographic purposes</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://equitus.ai/ontology/ecommerce#IncomeLevel">
    <rdfs:label>Income Level</rdfs:label>
    <rdfs:comment>Income bracket classification</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://equitus.ai/ontology/ecommerce#EducationLevel">
    <rdfs:label>Education Level</rdfs:label>
    <rdfs:comment>Highest level of education attained</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://equitus.ai/ontology/ecommerce#Occupation">
    <rdfs:label>Occupation</rdfs:label>
    <rdfs:comment>Professional occupation or job category</rdfs:comment>
  </owl:Class>

  <!-- =============================================== -->
  <!-- ADDRESS & LOCATION CLASSES -->
  <!-- =============================================== -->

  <owl:Class rdf:about="http://equitus.ai/ontology/ecommerce#Address">
    <rdfs:label>Address</rdfs:label>
    <rdfs:comment>Physical or postal address</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://equitus.ai/ontology/ecommerce#BillingAddress">
    <rdfs:label>Billing Address</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://equitus.ai/ontology/ecommerce#Address"/>
    <rdfs:comment>Address used for billing purposes</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://equitus.ai/ontology/ecommerce#ShippingAddress">
    <rdfs:label>Shipping Address</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://equitus.ai/ontology/ecommerce#Address"/>
    <rdfs:comment>Address where products are delivered</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://equitus.ai/ontology/ecommerce#Country">
    <rdfs:label>Country</rdfs:label>
    <rdfs:comment>Country within an address</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://equitus.ai/ontology/ecommerce#Region">
    <rdfs:label>Region</rdfs:label>
    <rdfs:comment>State, province, or administrative region</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://equitus.ai/ontology/ecommerce#City">
    <rdfs:label>City</rdfs:label>
    <rdfs:comment>City or municipality</rdfs:comment>
  </owl:Class>

  <!-- =============================================== -->
  <!-- PRODUCT CLASSES -->
  <!-- =============================================== -->

  <owl:Class rdf:about="http://equitus.ai/ontology/ecommerce#Product">
    <rdfs:label>Product</rdfs:label>
    <rdfs:comment>An item or service available for purchase</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://equitus.ai/ontology/ecommerce#PhysicalProduct">
    <rdfs:label>Physical Product</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://equitus.ai/ontology/ecommerce#Product"/>
    <rdfs:comment>A tangible product that requires shipping</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://equitus.ai/ontology/ecommerce#DigitalProduct">
    <rdfs:label>Digital Product</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://equitus.ai/ontology/ecommerce#Product"/>
    <rdfs:comment>A digital product delivered electronically</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://equitus.ai/ontology/ecommerce#Service">
    <rdfs:label>Service</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://equitus.ai/ontology/ecommerce#Product"/>
    <rdfs:comment>A service offering rather than a physical or digital good</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://equitus.ai/ontology/ecommerce#ProductVariant">
    <rdfs:label>Product Variant</rdfs:label>
    <rdfs:comment>A specific variation of a product (size, color, etc.)</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://equitus.ai/ontology/ecommerce#ProductBundle">
    <rdfs:label>Product Bundle</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://equitus.ai/ontology/ecommerce#Product"/>
    <rdfs:comment>A collection of products sold together</rdfs:comment>
  </owl:Class>

  <!-- =============================================== -->
  <!-- PRODUCT CATEGORY CLASSES -->
  <!-- =============================================== -->

  <owl:Class rdf:about="http://equitus.ai/ontology/ecommerce#Category">
    <rdfs:label>Category</rdfs:label>
    <rdfs:comment>A classification for organizing products</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://equitus.ai/ontology/ecommerce#RootCategory">
    <rdfs:label>Root Category</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://equitus.ai/ontology/ecommerce#Category"/>
    <rdfs:comment>Top-level category with no parent</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://equitus.ai/ontology/ecommerce#SubCategory">
    <rdfs:label>Sub Category</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://equitus.ai/ontology/ecommerce#Category"/>
    <rdfs:comment>A category that has a parent category</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://equitus.ai/ontology/ecommerce#Brand">
    <rdfs:label>Brand</rdfs:label>
    <rdfs:comment>Manufacturer or brand of a product</rdfs:comment>
  </owl:Class>
  
  <owl:Class rdf:about="http://equitus.ai/ontology/ecommerce#Manufacturer">
    <rdfs:label>Manufacturer</rdfs:label>
    <rdfs:comment>The company that manufactures the product.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://equitus.ai/ontology/ecommerce#Tag">
    <rdfs:label>Tag</rdfs:label>
    <rdfs:comment>Keyword or label for product classification and search</rdfs:comment>
  </owl:Class>

  <!-- =============================================== -->
  <!-- PRICING & FINANCIAL CLASSES -->
  <!-- =============================================== -->

  <owl:Class rdf:about="http://equitus.ai/ontology/ecommerce#Price">
    <rdfs:label>Price</rdfs:label>
    <rdfs:comment>Monetary value of a product or service</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://equitus.ai/ontology/ecommerce#Discount">
    <rdfs:label>Discount</rdfs:label>
    <rdfs:comment>Price reduction or promotional offer</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://equitus.ai/ontology/ecommerce#Tax">
    <rdfs:label>Tax</rdfs:label>
    <rdfs:comment>Tax applied to products or orders</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://equitus.ai/ontology/ecommerce#Currency">
    <rdfs:label>Currency</rdfs:label>
    <rdfs:comment>Monetary currency used for pricing</rdfs:comment>
  </owl:Class>
  
  <owl:Class rdf:about="http://equitus.ai/ontology/ecommerce#Promotion">
    <rdfs:label>Promotion</rdfs:label>
    <rdfs:comment>A special offer or campaign to increase sales.</rdfs:comment>
  </owl:Class>

  <!-- =============================================== -->
  <!-- ORDER & TRANSACTION CLASSES -->
  <!-- =============================================== -->

  <owl:Class rdf:about="http://equitus.ai/ontology/ecommerce#Order">
    <rdfs:label>Order</rdfs:label>
    <rdfs:comment>A customer's purchase request</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://equitus.ai/ontology/ecommerce#OrderItem">
    <rdfs:label>Order Item</rdfs:label>
    <rdfs:comment>Individual product within an order</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://equitus.ai/ontology/ecommerce#OrderStatus">
    <rdfs:label>Order Status</rdfs:label>
    <rdfs:comment>Current state of an order in the fulfillment process</rdfs:comment>
  </owl:Class>
  
  <ecom:OrderStatus rdf:about="http://equitus.ai/ontology/ecommerce#Pending">
    <rdfs:label>Pending</rdfs:label>
  </ecom:OrderStatus>
  <ecom:OrderStatus rdf:about="http://equitus.ai/ontology/ecommerce#Processing">
    <rdfs:label>Processing</rdfs:label>
  </ecom:OrderStatus>
  <ecom:OrderStatus rdf:about="http://equitus.ai/ontology/ecommerce#Shipped">
    <rdfs:label>Shipped</rdfs:label>
  </ecom:OrderStatus>
  <ecom:OrderStatus rdf:about="http://equitus.ai/ontology/ecommerce#Delivered">
    <rdfs:label>Delivered</rdfs:label>
  </ecom:OrderStatus>
  <ecom:OrderStatus rdf:about="http://equitus.ai/ontology/ecommerce#Cancelled">
    <rdfs:label>Cancelled</rdfs:label>
  </ecom:OrderStatus>
  <ecom:OrderStatus rdf:about="http://equitus.ai/ontology/ecommerce#Returned">
    <rdfs:label>Returned</rdfs:label>
  </ecom:OrderStatus>

  <owl:Class rdf:about="http://equitus.ai/ontology/ecommerce#Payment">
    <rdfs:label>Payment</rdfs:label>
    <rdfs:comment>Payment transaction for an order</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://equitus.ai/ontology/ecommerce#PaymentMethod">
    <rdfs:label>Payment Method</rdfs:label>
    <rdfs:comment>Method used to pay for an order</rdfs:comment>
  </owl:Class>
  
  <owl:Class rdf:about="http://equitus.ai/ontology/ecommerce#CreditCard">
    <rdfs:label>Credit Card</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://equitus.ai/ontology/ecommerce#PaymentMethod"/>
  </owl:Class>
  
  <owl:Class rdf:about="http://equitus.ai/ontology/ecommerce#PayPal">
    <rdfs:label>PayPal</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://equitus.ai/ontology/ecommerce#PaymentMethod"/>
  </owl:Class>
  
  <owl:Class rdf:about="http://equitus.ai/ontology/ecommerce#BankTransfer">
    <rdfs:label>Bank Transfer</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://equitus.ai/ontology/ecommerce#PaymentMethod"/>
  </owl:Class>

  <owl:Class rdf:about="http://equitus.ai/ontology/ecommerce#ShoppingCart">
    <rdfs:label>Shopping Cart</rdfs:label>
    <rdfs:comment>Temporary collection of items before purchase</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://equitus.ai/ontology/ecommerce#Wishlist">
    <rdfs:label>Wishlist</rdfs:label>
    <rdfs:comment>Collection of products a customer wants to purchase later</rdfs:comment>
  </owl:Class>

  <!-- =============================================== -->
  <!-- INVENTORY & FULFILLMENT CLASSES -->
  <!-- =============================================== -->

  <owl:Class rdf:about="http://equitus.ai/ontology/ecommerce#Inventory">
    <rdfs:label>Inventory</rdfs:label>
    <rdfs:comment>Stock information for a product</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://equitus.ai/ontology/ecommerce#Warehouse">
    <rdfs:label>Warehouse</rdfs:label>
    <rdfs:comment>Physical location where inventory is stored</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://equitus.ai/ontology/ecommerce#Shipment">
    <rdfs:label>Shipment</rdfs:label>
    <rdfs:comment>Physical delivery of products to customer</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://equitus.ai/ontology/ecommerce#ShippingMethod">
    <rdfs:label>Shipping Method</rdfs:label>
    <rdfs:comment>Delivery service and speed option</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://equitus.ai/ontology/ecommerce#Carrier">
    <rdfs:label>Carrier</rdfs:label>
    <rdfs:comment>Shipping company that delivers products</rdfs:comment>
  </owl:Class>

  <!-- =============================================== -->
  <!-- REVIEW & RATING CLASSES -->
  <!-- =============================================== -->

  <owl:Class rdf:about="http://equitus.ai/ontology/ecommerce#Review">
    <rdfs:label>Review</rdfs:label>
    <rdfs:comment>Customer feedback and evaluation of a product</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="http://equitus.ai/ontology/ecommerce#Rating">
    <rdfs:label>Rating</rdfs:label>
    <rdfs:comment>Numerical score given to a product</rdfs:comment>
  </owl:Class>

  <!-- =============================================== -->
  <!-- OBJECT PROPERTIES - Customer Relations -->
  <!-- =============================================== -->

  <owl:ObjectProperty rdf:about="http://equitus.ai/ontology/ecommerce#hasAccount">
    <rdfs:label>has account</rdfs:label>
    <rdfs:domain rdf:resource="http://equitus.ai/ontology/ecommerce#Customer"/>
    <rdfs:range rdf:resource="http://equitus.ai/ontology/ecommerce#CustomerAccount"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://equitus.ai/ontology/ecommerce#hasDemographics">
    <rdfs:label>has demographics</rdfs:label>
    <rdfs:domain rdf:resource="http://equitus.ai/ontology/ecommerce#Customer"/>
    <rdfs:range rdf:resource="http://equitus.ai/ontology/ecommerce#Demographics"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://equitus.ai/ontology/ecommerce#belongsToSegment">
    <rdfs:label>belongs to segment</rdfs:label>
    <rdfs:domain rdf:resource="http://equitus.ai/ontology/ecommerce#Customer"/>
    <rdfs:range rdf:resource="http://equitus.ai/ontology/ecommerce#CustomerSegment"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://equitus.ai/ontology/ecommerce#hasBillingAddress">
    <rdfs:label>has billing address</rdfs:label>
    <rdfs:domain rdf:resource="http://equitus.ai/ontology/ecommerce#Customer"/>
    <rdfs:range rdf:resource="http://equitus.ai/ontology/ecommerce#BillingAddress"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://equitus.ai/ontology/ecommerce#hasShippingAddress">
    <rdfs:label>has shipping address</rdfs:label>
    <rdfs:domain rdf:resource="http://equitus.ai/ontology/ecommerce#Customer"/>
    <rdfs:range rdf:resource="http://equitus.ai/ontology/ecommerce#ShippingAddress"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://equitus.ai/ontology/ecommerce#placedOrder">
    <rdfs:label>placed order</rdfs:label>
    <rdfs:domain rdf:resource="http://equitus.ai/ontology/ecommerce#Customer"/>
    <rdfs:range rdf:resource="http://equitus.ai/ontology/ecommerce#Order"/>
    <owl:inverseOf rdf:resource="http://equitus.ai/ontology/ecommerce#orderedBy"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://equitus.ai/ontology/ecommerce#orderedBy">
    <rdfs:label>ordered by</rdfs:label>
    <rdfs:domain rdf:resource="http://equitus.ai/ontology/ecommerce#Order"/>
    <rdfs:range rdf:resource="http://equitus.ai/ontology/ecommerce#Customer"/>
  </owl:ObjectProperty>
  
  <owl:ObjectProperty rdf:about="http://equitus.ai/ontology/ecommerce#hasShoppingCart">
    <rdfs:label>has shopping cart</rdfs:label>
    <rdfs:domain rdf:resource="http://equitus.ai/ontology/ecommerce#Customer"/>
    <rdfs:range rdf:resource="http://equitus.ai/ontology/ecommerce#ShoppingCart"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://equitus.ai/ontology/ecommerce#hasWishlist">
    <rdfs:label>has wishlist</rdfs:label>
    <rdfs:domain rdf:resource="http://equitus.ai/ontology/ecommerce#Customer"/>
    <rdfs:range rdf:resource="http://equitus.ai/ontology/ecommerce#Wishlist"/>
  </owl:ObjectProperty>

  <!-- =============================================== -->
  <!-- OBJECT PROPERTIES - Address Relations -->
  <!-- =============================================== -->

  <owl:ObjectProperty rdf:about="http://equitus.ai/ontology/ecommerce#locatedInCountry">
    <rdfs:label>located in country</rdfs:label>
    <rdfs:domain rdf:resource="http://equitus.ai/ontology/ecommerce#Address"/>
    <rdfs:range rdf:resource="http://equitus.ai/ontology/ecommerce#Country"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://equitus.ai/ontology/ecommerce#locatedInRegion">
    <rdfs:label>located in region</rdfs:label>
    <rdfs:domain rdf:resource="http://equitus.ai/ontology/ecommerce#Address"/>
    <rdfs:range rdf:resource="http://equitus.ai/ontology/ecommerce#Region"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://equitus.ai/ontology/ecommerce#locatedInCity">
    <rdfs:label>located in city</rdfs:label>
    <rdfs:domain rdf:resource="http://equitus.ai/ontology/ecommerce#Address"/>
    <rdfs:range rdf:resource="http://equitus.ai/ontology/ecommerce#City"/>
  </owl:ObjectProperty>

  <!-- =============================================== -->
  <!-- OBJECT PROPERTIES - Product Relations -->
  <!-- =============================================== -->

  <owl:ObjectProperty rdf:about="http://equitus.ai/ontology/ecommerce#belongsToCategory">
    <rdfs:label>belongs to category</rdfs:label>
    <rdfs:domain rdf:resource="http://equitus.ai/ontology/ecommerce#Product"/>
    <rdfs:range rdf:resource="http://equitus.ai/ontology/ecommerce#Category"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://equitus.ai/ontology/ecommerce#hasSubCategory">
    <rdfs:label>has sub category</rdfs:label>
    <rdfs:domain rdf:resource="http://equitus.ai/ontology/ecommerce#Category"/>
    <rdfs:range rdf:resource="http://equitus.ai/ontology/ecommerce#SubCategory"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://equitus.ai/ontology/ecommerce#hasParentCategory">
    <rdfs:label>has parent category</rdfs:label>
    <rdfs:domain rdf:resource="http://equitus.ai/ontology/ecommerce#SubCategory"/>
    <rdfs:range rdf:resource="http://equitus.ai/ontology/ecommerce#Category"/>
    <owl:inverseOf rdf:resource="http://equitus.ai/ontology/ecommerce#hasSubCategory"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://equitus.ai/ontology/ecommerce#hasBrand">
    <rdfs:label>has brand</rdfs:label>
    <rdfs:domain rdf:resource="http://equitus.ai/ontology/ecommerce#Product"/>
    <rdfs:range rdf:resource="http://equitus.ai/ontology/ecommerce#Brand"/>
  </owl:ObjectProperty>
  
  <owl:ObjectProperty rdf:about="http://equitus.ai/ontology/ecommerce#hasManufacturer">
    <rdfs:label>has manufacturer</rdfs:label>
    <rdfs:domain rdf:resource="http://equitus.ai/ontology/ecommerce#Product"/>
    <rdfs:range rdf:resource="http://equitus.ai/ontology/ecommerce#Manufacturer"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://equitus.ai/ontology/ecommerce#hasVariant">
    <rdfs:label>has variant</rdfs:label>
    <rdfs:domain rdf:resource="http://equitus.ai/ontology/ecommerce#Product"/>
    <rdfs:range rdf:resource="http://equitus.ai/ontology/ecommerce#ProductVariant"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://equitus.ai/ontology/ecommerce#variantOf">
    <rdfs:label>variant of</rdfs:label>
    <rdfs:domain rdf:resource="http://equitus.ai/ontology/ecommerce#ProductVariant"/>
    <rdfs:range rdf:resource="http://equitus.ai/ontology/ecommerce#Product"/>
    <owl:inverseOf rdf:resource="http://equitus.ai/ontology/ecommerce#hasVariant"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://equitus.ai/ontology/ecommerce#hasTag">
    <rdfs:label>has tag</rdfs:label>
    <rdfs:domain rdf:resource="http://equitus.ai/ontology/ecommerce#Product"/>
    <rdfs:range rdf:resource="http://equitus.ai/ontology/ecommerce#Tag"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://equitus.ai/ontology/ecommerce#containsProduct">
    <rdfs:label>contains product</rdfs:label>
    <rdfs:domain rdf:resource="http://equitus.ai/ontology/ecommerce#ProductBundle"/>
    <rdfs:range rdf:resource="http://equitus.ai/ontology/ecommerce#Product"/>
  </owl:ObjectProperty>

  <!-- =============================================== -->
  <!-- OBJECT PROPERTIES - Pricing Relations -->
  <!-- =============================================== -->

  <owl:ObjectProperty rdf:about="http://equitus.ai/ontology/ecommerce#hasPrice">
    <rdfs:label>has price</rdfs:label>
    <rdfs:domain rdf:resource="http://equitus.ai/ontology/ecommerce#Product"/>
    <rdfs:range rdf:resource="http://equitus.ai/ontology/ecommerce#Price"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://equitus.ai/ontology/ecommerce#hasDiscount">
    <rdfs:label>has discount</rdfs:label>
    <rdfs:domain rdf:resource="http://equitus.ai/ontology/ecommerce#Product"/>
    <rdfs:range rdf:resource="http://equitus.ai/ontology/ecommerce#Discount"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="http://equitus.ai/ontology/ecommerce#hasCurrency">
    <rdfs:label>has currency</rdfs:label>
    <rdfs:domain rdf:resource="http://equitus.ai/ontology/ecommerce#Price"/>
    <rdfs:range rdf:resource="http://equitus.ai/ontology/ecommerce#Currency"/>
  </owl:ObjectProperty>
  
  <owl:ObjectProperty rdf:about="http://equitus.ai/ontology/ecommerce#hasPromotion">
    <rdfs:label>has promotion</rdfs:label>
    <rdfs:domain rdf:resource="http://equitus.ai/ontology/ecommerce#Order"/>
    <rdfs:range rdf:resource="http://equitus.ai/ontology/ecommerce#Promotion"/>
  </owl:ObjectProperty>

  <!-- =============================================== -->
  <!-- OBJECT PROPERTIES - Order Relations -->
  <!-- =============================================== -->

  <owl:ObjectProperty rdf:about="http://equitus.ai/ontology/ecommerce#hasOrderItem">
    <rdfs:label>has order item</rdfs:label>
    <rdfs:domain rdf:resource="http://equitus.ai/ontology/ecommerce#Order"/>
